# ─── Base de Datos (Prisma) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/pintuclic?schema=public"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT (HU-SEG-02) ──────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── SMTP — Brevo (M18 Notificaciones) ──────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo_de_inicio_en_brevo@ejemplo.com
SMTP_PASS=tu_clave_smtp_maestra_de_brevo
SMTP_FROM="Pintu Clic <notificaciones@pintuclic.com>"

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
