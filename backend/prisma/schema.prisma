// ⚠️  FUENTE ÚNICA de la estructura de base de datos para Prisma.
//
// ADR-004 — Este schema MAPEA el DDL existente en `bd/sql/schema_pintuclic.sql`
// mediante @@map / @map, en lugar de describir un modelo paralelo. `bd/` está
// bloqueado y es la base real; Prisma debe hablar de las mismas tablas.
//
// Ejecutar `npx prisma generate` cada vez que se modifique este archivo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS — espejo exacto de los tipos definidos en bd/sql/schema_pintuclic.sql
// =============================================================================

/// Ciclo de vida de una sesión de usuario (M20 · HU-SEG-02)
enum EstadoSesion {
  activa
  cerrada
  expirada
  revocada

  @@map("enum_estado_sesion")
}

/// Determina la ventana de inactividad aplicable (RF-SEG-02-02)
enum TipoSesion {
  admin
  cliente

  @@map("enum_tipo_sesion")
}

/// Causa por la que una sesión dejó de estar activa (RF-SEG-02-06)
enum MotivoCierreSesion {
  cierre_manual
  inactividad
  cambio_contrasena
  cuenta_desactivada
  permisos_retirados

  @@map("enum_motivo_cierre_sesion")
}

/// Estado de las solicitudes de supresión de datos (Habeas Data · HU-SEG-05)
enum EstadoSolicitudSupresion {
  pendiente
  en_proceso
  aprobada
  rechazada

  @@map("enum_estado_solicitud_supresion")
}

/// Estado de la cuenta de usuario. Pertenece al dominio de M04; M20 solo lo lee.
enum EstadoUsuario {
  activo
  inactivo
  bloqueado
  pendiente

  @@map("enum_estado_usuario")
}

/// Estado general de entidades de configuración y catálogos (M17)
/// Estado de una cotización (M21); `borrador` se trata igual que `solicitada`
enum EstadoCotizacion {
  solicitada
  borrador
  enviada
  aprobada
  rechazada
  vencida

  @@map("enum_estado_cotizacion")
}

enum EstadoGeneral {
  activo
  inactivo

  @@map("enum_estado_general")
}

/// Tipo de cuenta de usuario (M04 / M17)
enum TipoUsuario {
  normal
  empresa

  @@map("enum_tipo_usuario")
}

/// Tipo de solicitud de cuenta corporativa (M04 · HU-CUE-03 / HU-CUE-06)
enum TipoSolicitudEmpresa {
  registro
  ascenso_particular

  @@map("enum_tipo_solicitud_empresa")
}

/// Estado del trámite de una solicitud de empresa o NIT (M04 · HU-CUE-03 / HU-CUE-09)
enum EstadoSolicitudEmpresa {
  pendiente
  aprobada
  rechazada

  @@map("enum_estado_solicitud_empresa")
}

/// Propósito transaccional del código OTP efímero (M04 · HU-CUE-01, 05, 06)
enum TipoCodigoOtp {
  registro
  recuperacion_password
  cambio_correo

  @@map("enum_tipo_codigo_otp")
}

/// Áreas de configuración general del sistema (M17 · RFC-M17-001)
enum AreaParametro {
  autenticacion
  comunicaciones
  comercial

  @@map("enum_area_parametro")
}

/// Tipos de datos para parámetros de configuración (M17 · RFC-M17-001)
enum TipoDatoParametro {
  numero
  texto
  booleano

  @@map("enum_tipo_dato_parametro")
}

/// Catálogo de comunicaciones transaccionales que envía el sistema (M18 · RF-NOT-01-02)
enum TipoComunicacion {
  registro_otp
  recuperacion_password
  activacion_empleado
  cambio_correo_otp
  cambio_correo_confirmado
  dictamen_empresa
  /// M03 · I9: el servicio de IA acumuló los fallos consecutivos configurados
  alerta_servicio_ia

  @@map("enum_tipo_comunicacion")
}

/// Resultado de un intento de envío transaccional (M18 · RF-NOT-01-03, RF-NOT-01-04)
enum EstadoEnvioNotificacion {
  pendiente
  enviado
  fallido

  @@map("enum_estado_envio_notificacion")
}

/// Motivo de un ajuste de existencia referencial (M13)
enum MotivoAjusteInventario {
  conteo_fisico
  ingreso_mercancia
  salida
  correccion
  otro
  carga_masiva
  venta
  devolucion

  @@map("enum_motivo_ajuste_inventario")
}

/// Origen de un ajuste de existencia referencial (M13); samit queda reservado a la integración futura
enum OrigenAjusteInventario {
  manual
  carga_masiva
  samit
  orden

  @@map("enum_origen_ajuste_inventario")
}

/// Cómo se expresa un descuento: porcentaje o importe fijo (M06; los eventos solo usan porcentaje)
enum TipoValorDescuento {
  porcentaje
  importe_fijo

  @@map("enum_tipo_valor_descuento")
}

/// A quién va dirigido un cupón (M06)
enum AudienciaDescuento {
  todos
  particular
  empresa

  @@map("enum_audiencia_descuento")
}

/// Dónde se ve el patrocinio de productos (M14 · A7)
enum UbicacionPatrocinio {
  listado
  inicio
  complementarios

  @@map("enum_ubicacion_patrocinio")
}

/// Qué patrocina una campaña (M14 · A3)
enum TipoObjetivoPatrocinio {
  producto
  linea
  marca

  @@map("enum_tipo_objetivo_patrocinio")
}

/// Espacios del sitio donde se muestran anuncios (M14 · B1)
enum EspacioPublicitario {
  inicio
  catalogo
  ficha

  @@map("enum_espacio_publicitario")
}

/// Imagen de escritorio o móvil de un anuncio (M14 · B10)
enum VarianteImagenAnuncio {
  escritorio
  movil

  @@map("enum_variante_imagen_anuncio")
}

/// Original o versión reducida de una imagen de anuncio (M14 · B11)
enum TamanoImagenAnuncio {
  original
  mediano
  pequeno

  @@map("enum_tamano_imagen_anuncio")
}

/// A qué se refiere una medición (M14 · M1)
enum EntidadMedicion {
  campania
  anuncio

  @@map("enum_entidad_medicion")
}

/// Qué se cuenta en una medición (M14 · M1)
enum EventoMedicion {
  impresion
  clic

  @@map("enum_evento_medicion")
}

/// Qué parte del catálogo cubre una regla de evento (M06 · R5)
enum TipoObjetivoEvento {
  marca
  linea
  categoria
  subcategoria
  producto
  variante

  @@map("enum_tipo_objetivo_evento")
}

/// Qué se saca de una regla o de un evento (M06 · R6): lo mismo más color y familia de color
enum TipoExclusionEvento {
  marca
  linea
  categoria
  subcategoria
  producto
  variante
  color
  familia_color

  @@map("enum_tipo_exclusion_evento")
}

/// Tipo de solicitud del formulario de contacto (M15 · HU-ATC-02); cotizacion es solo intención (RF-ATC-02-07)
enum TipoSolicitudContacto {
  consulta
  cotizacion
  reclamo

  @@map("enum_tipo_solicitud_contacto")
}

/// Estado de una solicitud de contacto en la bandeja de atención (M15 · HU-ATC-02, R12)
enum EstadoSolicitudContacto {
  en_revision
  atendida
  rechazada

  @@map("enum_estado_solicitud_contacto")
}

/// Rol del autor de un mensaje dentro del hilo de una solicitud de contacto (M15 · R12)
enum RolAutorMensajeSolicitud {
  cliente
  equipo

  @@map("enum_rol_autor_mensaje_solicitud")
}

/// Día de la semana del horario de atención humana (M15 · HU-ATC-04)
enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo

  @@map("enum_dia_semana")
}

/// Estado comercial de una variante (M01 · HU-CAT-03)
enum EstadoProducto {
  activo
  inactivo
  agotado
  descontinuado

  @@map("enum_estado_producto")
}

/// Estado editorial de una página institucional (M16 · HU-CON-01 / HU-CON-03)
enum EstadoContenido {
  borrador
  publicado
  archivado

  @@map("enum_estado_contenido")
}

// =============================================================================
// MÓDULO M04 — USUARIO
// =============================================================================

model Usuario {
  idUsuario                 Int           @id @default(autoincrement()) @map("id_usuario")
  nombre                    String        @db.VarChar(150)
  telefono                  String?       @db.VarChar(20)
  correo                    String        @unique @db.VarChar(150)
  /// Hash BCrypt (coste ≥ 12). RN-SEG-02: toda cuenta tiene contraseña, incluidas las de Google.
  contrasena                String        @db.VarChar(255)
  idRol                     Int?          @map("id_rol")
  estado                    EstadoUsuario @default(activo)
  tipo                      TipoUsuario   @default(normal)
  cambioContrasenaPendiente Boolean       @default(false) @map("cambio_contrasena_pendiente")

  sesiones               Sesion[]
  consentimientos        ConsentimientoUsuario[]
  solicitudesSupresion   SolicitudSupresion[]
  parametrosActualizados ParametroSistema[]      @relation("ParametroUsuarioActualizo")

  rolDirecto Rol?        @relation("UsuarioRolDirecto", fields: [idRol], references: [idRol])
  usuarioRol UsuarioRol?

  // M04 Relaciones
  cuentaEmpresa               CuentaEmpresa?
  direcciones                 DireccionCliente[]
  solicitudesEmpresa          SolicitudEmpresa[]          @relation("SolicitudesEmpresaUsuario")
  solicitudesEmpresaRevisadas SolicitudEmpresa[]          @relation("SolicitudesEmpresaRevisadas")
  solicitudesNit              SolicitudActualizacionNit[] @relation("SolicitudesNitUsuario")
  solicitudesNitRevisadas     SolicitudActualizacionNit[] @relation("SolicitudesNitRevisadas")
  identidadesExternas         UsuarioIdentidadExterna[]

  // M07 Relaciones
  solicitudesCompra SolicitudCompra[]

  // M08 Relaciones
  ordenes               Orden[]
  historialEstadosOrden HistorialEstadoOrden[]
  notasOrden            NotaOrden[]
  contactosOrden        ContactoOrden[]

  // M13 Relaciones
  ajustesInventario AjusteInventario[]

  // M06 Relaciones
  eventosDescuentoActualizados EventoDescuento[] @relation("EventoDescuentoUsuarioActualizo")
  campaniasPatrocinioActualizadas CampaniaPatrocinio[] @relation("CampaniaPatrocinioUsuarioActualizo")
  anunciosActualizados AnuncioPublicitario[] @relation("AnuncioPublicitarioUsuarioActualizo")
  cuponesActualizados          Cupon[]           @relation("CuponUsuarioActualizo")
  usosCupon                    CuponUso[]

  // M15 Relaciones
  solicitudesContacto        SolicitudContacto[]
  mensajesSolicitudContacto  MensajeSolicitudContacto[]

  // M16 Relaciones
  paginasInstitucionales PaginaInstitucional[] @relation("PaginaInstitucionalAutor")
  entradasFaq            FaqEntrada[]          @relation("FaqEntradaAutor")
  contactoActualizado    ContactoInstitucional[] @relation("ContactoInstitucionalUsuarioActualizo")
  imagenesCategoriaInicio ImagenCategoriaInicio[] @relation("ImagenCategoriaInicioUsuarioActualizo")

  // M05 Relaciones
  carrito Carrito?

  // M21 Relaciones
  cotizaciones           Cotizacion[] @relation("CotizacionCliente")
  cotizacionesRespondidas Cotizacion[] @relation("CotizacionRespondidaPor")

  // M03 Relaciones
  configuracionAsesoriaActualizada ConfiguracionAsesoria[] @relation("ConfiguracionAsesoriaUsuarioActualizo")

  // M20 Relaciones
  registrosAuditoria RegistroAuditoria[]

  // M11 Relaciones (Postventa)
  solicitudesPostventa SolicitudPostventa[] @relation("SolicitudesPostventaUsuario")
  solicitudesPostventaResueltas SolicitudPostventa[] @relation("SolicitudesPostventaResueltas")
  historialPostventaAutor HistorialEstadoPostventa[]

  @@map("usuario")
}

// =============================================================================
// MÓDULO M17 — ADMINISTRACIÓN, EMPLEADOS Y PERMISOS
// =============================================================================

/// Política de descuento de un tipo de cliente empresa (M06 · R10, R11)
model Descuento {
  idDescuento         Int           @id @default(autoincrement()) @map("id_descuento")
  /// Monto máximo de ahorro por compra; 0 = sin tope
  tope                Decimal       @default(0.00) @db.Decimal(12, 2)
  porcentajeDescuento Decimal       @map("porcentaje_descuento") @db.Decimal(5, 2)
  estado              EstadoGeneral @default(activo)
  /// Total del carrito (después de eventos, IVA incluido) desde el que aplica; 0 = sin mínimo
  montoMinimoCompra   Decimal       @default(0.00) @map("monto_minimo_compra") @db.Decimal(12, 2)

  subRoles SubRolEmpresa[]

  @@map("descuento")
}

/// Tipo de cliente empresa (Proveedor, Constructora…) con su descuento (M06 · D8). Se asigna en cuenta_empresa.
model SubRolEmpresa {
  idSubRolEmpresa Int           @id @default(autoincrement()) @map("id_sub_rol_empresa")
  nombre          String        @db.VarChar(100)
  idDescuento     Int?          @map("id_descuento")
  estado          EstadoGeneral @default(activo)

  descuento Descuento?      @relation(fields: [idDescuento], references: [idDescuento], onDelete: SetNull, map: "fk_subrol_descuento")
  roles     Rol[]
  cuentas   CuentaEmpresa[]

  @@index([idDescuento], map: "idx_subrol_descuento")
  // Índice único funcional lower(btrim(nombre)) solo en el DDL: Prisma no expresa índices sobre expresiones.
  @@map("sub_rol_empresa")
}

/// Rol o perfil de asignación relacional (ADR-006)
model Rol {
  idRol            Int           @id @default(autoincrement()) @map("id_rol")
  nombre           String        @unique @db.VarChar(100)
  idSubRolEmpresa  Int?          @map("id_sub_rol_empresa")
  estado           EstadoGeneral @default(activo)

  subRolEmpresa    SubRolEmpresa?      @relation(fields: [idSubRolEmpresa], references: [idSubRolEmpresa], onDelete: SetNull, map: "fk_rol_subrol")
  asignaciones     AsignacionPermiso[]
  usuariosConRol   UsuarioRol[]
  usuariosDirectos Usuario[]     @relation("UsuarioRolDirecto")
  cotizaciones     Cotizacion[]

  @@map("rol")
}

/// Catálogo maestro de permisos atómicos del sistema
model Permiso {
  idPermiso   Int           @id @default(autoincrement()) @map("id_permiso")
  nombre      String        @unique @db.VarChar(100)
  descripcion String?
  estado      EstadoGeneral @default(activo)

  asignaciones AsignacionPermiso[]

  @@map("permisos")
}

/// Asignación N:M de permisos a perfiles individuales
model AsignacionPermiso {
  idAsignacionPermiso Int @id @default(autoincrement()) @map("id_asignacion_permiso")
  idRol               Int @map("id_rol")
  idPermiso           Int @map("id_permiso")

  rol     Rol     @relation(fields: [idRol], references: [idRol], onDelete: Cascade)
  permiso Permiso @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@unique([idRol, idPermiso], map: "uq_rol_permiso")
  @@index([idRol])
  @@index([idPermiso])
  @@map("asignacion_permiso")
}

/// Relación 1:1 Usuario - Rol con restricción UNIQUE(id_usuario)
model UsuarioRol {
  idUsuarioRol Int @id @default(autoincrement()) @map("id_usuario_rol")
  idUsuario    Int @unique @map("id_usuario")
  idRol        Int @map("id_rol")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  rol     Rol     @relation(fields: [idRol], references: [idRol], onDelete: Cascade)

  @@index([idUsuario])
  @@index([idRol])
  @@map("usuario_rol")
}

/// Parámetros de configuración general modificables en caliente por el administrador (M17 · HU-ADM-05, HU-ADM-07, RFC-M17-001)
model ParametroSistema {
  idParametro         Int                @id @default(autoincrement()) @map("id_parametro")
  clave               String             @unique @db.VarChar(100)
  area                AreaParametro
  tipoDato            TipoDatoParametro  @map("tipo_dato")
  descripcion         String
  valor               Json
  valorPorDefecto     Json               @map("valor_por_defecto")
  rangoMinimo         Decimal?           @map("rango_minimo") @db.Decimal(14, 2)
  rangoMaximo         Decimal?           @map("rango_maximo") @db.Decimal(14, 2)
  fechaActualizacion  DateTime           @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo  Int?               @map("id_usuario_actualizo")

  usuarioActualizo    Usuario?           @relation("ParametroUsuarioActualizo", fields: [idUsuarioActualizo], references: [idUsuario], onUpdate: Cascade, onDelete: SetNull)

  @@index([idUsuarioActualizo], map: "idx_parametro_sistema_usuario")
  @@map("parametro_sistema")
}

// =============================================================================
// MÓDULO M20 — SEGURIDAD Y PROTECCIÓN DE DATOS
// =============================================================================

/// HU-SEG-02. La clave es UUID y no autoincremental a propósito: el identificador
/// viaja en la cookie de sesión y un entero secuencial sería enumerable.
model Sesion {
  idSesion          String              @id @default(uuid()) @map("id_sesion") @db.Uuid
  idUsuario         Int                 @map("id_usuario")
  tipoSesion        TipoSesion          @map("tipo_sesion")
  fechaInicio       DateTime            @default(now()) @map("fecha_inicio") @db.Timestamptz(6)
  /// RF-SEG-02-03. Se renueva en cada operación del usuario (ventana deslizante).
  fechaUltimoAcceso DateTime            @default(now()) @map("fecha_ultimo_acceso") @db.Timestamptz(6)
  /// RF-SEG-02-02. Último acceso + ventana de inactividad del tipo de sesión.
  fechaExpiracion   DateTime            @map("fecha_expiracion") @db.Timestamptz(6)
  estado            EstadoSesion        @default(activa)
  /// Nulo mientras la sesión sigue activa.
  motivoCierre      MotivoCierreSesion? @map("motivo_cierre")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@index([idUsuario, estado])
  @@map("sesion")
}

/// HU-SEG-05. Versiones legales de la política de tratamiento de datos.
model AvisoPrivacidad {
  idAvisoPrivacidad Int     @id @default(autoincrement()) @map("id_aviso_privacidad")
  version           String  @unique @db.VarChar(50)
  descripcion       String
  /// Indica si es la versión activa que los usuarios deben consentir.
  esVigente         Boolean @default(true) @map("es_vigente")

  consentimientos ConsentimientoUsuario[]

  @@map("aviso_privacidad")
}

/// HU-SEG-05. Registro histórico auditable del consentimiento otorgado.
model ConsentimientoUsuario {
  idConsentimiento  Int      @id @default(autoincrement()) @map("id_consentimiento")
  idUsuario         Int      @map("id_usuario")
  idAvisoPrivacidad Int      @map("id_aviso_privacidad")
  fecha             DateTime @default(now()) @db.Timestamptz(6)

  usuario Usuario         @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  /// RESTRICT: un aviso consentido jamás se borra mientras exista su consentimiento.
  aviso   AvisoPrivacidad @relation(fields: [idAvisoPrivacidad], references: [idAvisoPrivacidad], onDelete: Restrict)

  @@unique([idUsuario, idAvisoPrivacidad], map: "uq_usuario_aviso")
  @@map("consentimiento_usuario")
}

/// HU-SEG-05. Ejercicio de derechos ARCO / supresión de datos (Habeas Data).
model SolicitudSupresion {
  idSolicitudSupresion Int                      @id @default(autoincrement()) @map("id_solicitud_supresion")
  idUsuario            Int                      @map("id_usuario")
  fechaSolicitud       DateTime                 @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  fechaResolucion      DateTime?                @map("fecha_resolucion") @db.Timestamptz(6)
  estado               EstadoSolicitudSupresion @default(pendiente)

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@index([idUsuario, estado])
  @@map("solicitud_supresion")
}

// =============================================================================
// MÓDULO M04 — CUENTAS, AUTENTICACIÓN Y PERFIL
// =============================================================================

/// Datos y NIT vigente de cada cuenta empresa aprobada (HU-CUE-09, HU-CUE-10, RFC-M04-001 C-1)
model CuentaEmpresa {
  idUsuario           Int               @id @map("id_usuario")
  nit                 String            @unique @db.VarChar(30)
  nombreEmpresa       String            @map("nombre_empresa") @db.VarChar(150)
  nombreRepresentante String            @map("nombre_representante") @db.VarChar(150)
  correoEmpresarial   String            @map("correo_empresarial") @db.VarChar(150)
  telefono            String            @db.VarChar(20)
  idSolicitudOrigen   String?           @map("id_solicitud_origen") @db.Uuid
  fechaAprobacion     DateTime          @default(now()) @map("fecha_aprobacion") @db.Timestamptz(6)
  fechaActualizacion  DateTime          @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  /// Tipo de cliente empresa que fija su descuento (M06 · D8); null = sin descuento
  idSubRolEmpresa     Int?     @map("id_sub_rol_empresa")

  subRolEmpresa   SubRolEmpresa?    @relation(fields: [idSubRolEmpresa], references: [idSubRolEmpresa], onDelete: SetNull, map: "fk_cuenta_empresa_sub_rol")
  usuario             Usuario           @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  solicitudOrigen     SolicitudEmpresa? @relation("CuentaEmpresaSolicitudOrigen", fields: [idSolicitudOrigen], references: [idSolicitud], onDelete: SetNull)

  @@index([idSolicitudOrigen], map: "idx_cuenta_empresa_solicitud")
  @@index([idSubRolEmpresa], map: "idx_cuenta_empresa_sub_rol")
  @@map("cuenta_empresa")
}

/// Custodia segura de documentos soporte adjuntos (RUT de renovación) en BYTEA (RFC-M04-001 C-3)
model DocumentoSoporte {
  idDocumento    String   @id @default(uuid()) @map("id_documento") @db.Uuid
  nombreOriginal String   @map("nombre_original") @db.VarChar(255)
  tipoMime       String   @map("tipo_mime") @db.VarChar(100)
  tamanoBytes    Int      @map("tamano_bytes")
  sha256         String   @db.Char(64)
  contenido      Bytes
  fechaCarga     DateTime @default(now()) @map("fecha_carga") @db.Timestamptz(6)

  solicitudesActualizacionNit SolicitudActualizacionNit[]

  @@map("documento_soporte")
}

/// Dirección de entrega del cliente, una sola por cuenta (HU-CUE-07, RFC-M04-001 C-4)
model DireccionCliente {
  idDireccion        String   @id @default(uuid()) @map("id_direccion") @db.Uuid
  idUsuario          Int      @map("id_usuario")
  direccion          String   @db.VarChar(255)
  barrio             String   @db.VarChar(100)
  apartamentoCasa    String?  @map("apartamento_casa") @db.VarChar(100)
  nombreApellido     String   @map("nombre_apellido") @db.VarChar(150)
  telefono           String   @db.VarChar(20)
  esPredeterminada   Boolean  @default(false) @map("es_predeterminada")
  latitud            Decimal? @db.Decimal(10, 7)
  longitud           Decimal? @db.Decimal(10, 7)
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)

  usuario            Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@unique([idUsuario], map: "uq_direccion_una_por_usuario")
  @@index([idUsuario], map: "idx_direccion_usuario")
  @@index([idUsuario, esPredeterminada], map: "idx_direccion_predeterminada")
  @@map("direccion_cliente")
}

/// Solicitudes de cuenta empresa inicial o ascenso particular (HU-CUE-03, HU-CUE-09, RFC-M04-001 C-2)
model SolicitudEmpresa {
  idSolicitud         String                 @id @default(uuid()) @map("id_solicitud") @db.Uuid
  idUsuario           Int                    @map("id_usuario")
  nombreEmpresa       String                 @map("nombre_empresa") @db.VarChar(150)
  nombreRepresentante String                 @map("nombre_representante") @db.VarChar(150)
  correoEmpresarial   String                 @map("correo_empresarial") @db.VarChar(150)
  telefono            String                 @db.VarChar(20)
  nit                 String                 @db.VarChar(30)
  tipoSolicitud       TipoSolicitudEmpresa   @default(registro) @map("tipo_solicitud")
  estado              EstadoSolicitudEmpresa @default(pendiente)
  motivoRechazo       String?                @map("motivo_rechazo")
  idAdminRevisor      Int?                   @map("id_admin_revisor")
  fechaSolicitud      DateTime               @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  fechaRevision       DateTime?              @map("fecha_revision") @db.Timestamptz(6)

  usuario             Usuario                @relation("SolicitudesEmpresaUsuario", fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  adminRevisor        Usuario?               @relation("SolicitudesEmpresaRevisadas", fields: [idAdminRevisor], references: [idUsuario], onDelete: SetNull)
  cuentasOriginadas   CuentaEmpresa[]        @relation("CuentaEmpresaSolicitudOrigen")

  @@index([nit], map: "idx_solicitud_empresa_nit")
  @@index([idUsuario], map: "idx_solicitud_empresa_usuario")
  @@index([estado], map: "idx_solicitud_empresa_estado")
  @@map("solicitud_empresa")
}

/// Solicitudes formales de renovación o actualización de NIT (HU-CUE-10, RFC-M04-001 C-2 y C-3)
model SolicitudActualizacionNit {
  idSolicitud         String                 @id @default(uuid()) @map("id_solicitud") @db.Uuid
  idUsuario           Int                    @map("id_usuario")
  nitAnterior         String                 @map("nit_anterior") @db.VarChar(30)
  nitNuevo            String                 @map("nit_nuevo") @db.VarChar(30)
  documentoAdjuntoUrl String?                @map("documento_adjunto_url")
  idDocumento         String?                @map("id_documento") @db.Uuid
  estado              EstadoSolicitudEmpresa @default(pendiente)
  motivoRechazo       String?                @map("motivo_rechazo")
  idAdminRevisor      Int?                   @map("id_admin_revisor")
  fechaSolicitud      DateTime               @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  fechaRevision       DateTime?              @map("fecha_revision") @db.Timestamptz(6)

  usuario             Usuario                @relation("SolicitudesNitUsuario", fields: [idUsuario], references: [idUsuario], onDelete: Cascade)
  adminRevisor        Usuario?               @relation("SolicitudesNitRevisadas", fields: [idAdminRevisor], references: [idUsuario], onDelete: SetNull)
  documento           DocumentoSoporte?      @relation(fields: [idDocumento], references: [idDocumento], onDelete: Restrict)

  @@index([idUsuario], map: "idx_solicitud_nit_usuario")
  @@index([estado], map: "idx_solicitud_nit_estado")
  @@index([idDocumento], map: "idx_solicitud_nit_documento")
  @@map("solicitud_actualizacion_nit")
}

/// Identidades federadas OAuth vinculadas a la cuenta (HU-CUE-02)
model UsuarioIdentidadExterna {
  idIdentidad      Int      @id @default(autoincrement()) @map("id_identidad")
  idUsuario        Int      @map("id_usuario")
  proveedor        String   @db.VarChar(50)
  idProveedor      String   @map("id_proveedor") @db.VarChar(255)
  correoProveedor  String?  @map("correo_proveedor") @db.VarChar(150)
  fechaVinculacion DateTime @default(now()) @map("fecha_vinculacion") @db.Timestamptz(6)

  usuario          Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@unique([proveedor, idProveedor], map: "uq_identidad_proveedor")
  @@unique([idUsuario, proveedor], map: "uq_usuario_proveedor")
  @@index([idUsuario], map: "idx_identidad_usuario")
  @@map("usuario_identidad_externa")
}

/// Códigos OTP efímeros transaccionales con hash seguro (HU-CUE-01, 05, 06, RFC-M04-001 C-5)
model CodigoVerificacion {
  idCodigo        String        @id @default(uuid()) @map("id_codigo") @db.Uuid
  correo          String        @db.VarChar(150)
  codigoHash      String        @map("codigo_hash") @db.VarChar(255)
  tipo            TipoCodigoOtp
  expiracion      DateTime      @db.Timestamptz(6)
  intentos        Int           @default(0)
  maxIntentos     Int           @default(3) @map("max_intentos")
  datosTemporales Json?         @map("datos_temporales")
  fechaCreacion   DateTime      @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  @@index([correo, tipo], map: "idx_codigo_correo_tipo")
  @@index([expiracion], map: "idx_codigo_expiracion")
  @@map("codigo_verificacion")
}

/// Control de intentos fallidos anti-fuerza bruta e indistinguibilidad por correo (HU-CUE-04, RFC-M04-001 C-6)
model ControlIntentoAcceso {
  correo             String    @id @db.VarChar(150)
  intentosFallidos   Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta     DateTime? @map("bloqueado_hasta") @db.Timestamptz(6)
  fechaUltimoIntento DateTime  @default(now()) @map("fecha_ultimo_intento") @db.Timestamptz(6)

  @@index([bloqueadoHasta], map: "idx_control_intento_bloqueo")
  @@map("control_intento_acceso")
}

// =============================================================================
// MÓDULO M18 — NOTIFICACIONES Y COMUNICACIONES
// =============================================================================

/// Contenido editable desde el panel para cada comunicación transaccional (HU-NOT-03)
model PlantillaNotificacion {
  idPlantilla        String           @id @default(uuid()) @map("id_plantilla") @db.Uuid
  tipo               TipoComunicacion @unique
  asunto             String           @db.VarChar(200)
  contenidoTexto     String           @map("contenido_texto")
  fechaActualizacion DateTime         @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?             @map("id_usuario_actualizo")

  @@map("plantilla_notificacion")
}

/// Registro de envíos transaccionales con su resultado y reintentos (RF-NOT-01-03, RF-NOT-01-04, RT-23)
model EnvioNotificacion {
  idEnvio       String                  @id @default(uuid()) @map("id_envio") @db.Uuid
  tipo          TipoComunicacion
  destinatario  String                  @db.VarChar(150)
  estado        EstadoEnvioNotificacion @default(pendiente)
  intentos      Int                     @default(0)
  maxIntentos   Int                     @default(3) @map("max_intentos")
  ultimoError   String?                 @map("ultimo_error")
  fechaCreacion DateTime                @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaResultado DateTime?              @map("fecha_resultado") @db.Timestamptz(6)

  rebotes RebotesNotificacion[]

  @@index([destinatario, tipo], map: "idx_envio_destinatario_tipo")
  @@index([estado], map: "idx_envio_estado")
  @@map("envio_notificacion")
}

/// Rebotes de entrega de correo para diagnóstico (HU-NOT-04, RF-NOT-04-04)
model RebotesNotificacion {
  idRebote      String    @id @default(uuid()) @map("id_rebote") @db.Uuid
  idEnvio       String?   @map("id_envio") @db.Uuid
  destinatario  String    @db.VarChar(150)
  motivo        String?
  fechaRegistro DateTime  @default(now()) @map("fecha_registro") @db.Timestamptz(6)

  envio EnvioNotificacion? @relation(fields: [idEnvio], references: [idEnvio], onDelete: SetNull)

  @@index([idEnvio], map: "idx_rebote_envio")
  @@map("rebote_notificacion")
}

// =============================================================================
// MÓDULO M13 — INVENTARIO REFERENCIAL (esquema 4.7)
// =============================================================================

/// Historial inmutable de ajustes de la existencia referencial de una variante (M13)
model AjusteInventario {
  idAjuste           Int                    @id @default(autoincrement()) @map("id_ajuste")
  idVariante         Int                    @map("id_variante")
  existenciaAnterior Int                    @map("existencia_anterior")
  existenciaNueva    Int                    @map("existencia_nueva")
  motivo             MotivoAjusteInventario @default(correccion)
  nota               String?                @db.VarChar(500)
  origen             OrigenAjusteInventario @default(manual)
  /// Agrupa los ajustes de una misma carga masiva; lo genera el cliente, sin tabla propia
  idCarga            String?                @map("id_carga") @db.Uuid
  idUsuario          Int?                   @map("id_usuario")
  /// Orden que movió la existencia de un combo; con el motivo y la variante es única (idempotencia)
  referencia         String?                @db.VarChar(100)
  fecha              DateTime               @default(now()) @db.Timestamptz(6)

  variante Variante @relation(fields: [idVariante], references: [idVariante], onDelete: Restrict, map: "fk_ajuste_variante")
  usuario  Usuario? @relation(fields: [idUsuario], references: [idUsuario], onDelete: SetNull, map: "fk_ajuste_usuario")

  @@index([idVariante, fecha(sort: Desc)], map: "idx_ajuste_variante_fecha")
  @@index([idCarga], map: "idx_ajuste_carga")
  @@index([idUsuario], map: "idx_ajuste_usuario")
  // Índice único parcial (WHERE referencia IS NOT NULL) solo en el DDL: Prisma no expresa índices parciales.
  @@map("ajuste_inventario")
}

// =============================================================================
// MÓDULO M05 — CARRITO DE COMPRAS (esquema 4.15)
// =============================================================================

/// Carrito vivo (HU-CAR-01, HU-CAR-04): uno por cuenta o uno por token de visitante
model Carrito {
  idCarrito            Int      @id @default(autoincrement()) @map("id_carrito")
  /// SHA-256 del token opaco de la cookie `pc_cart`, nunca el token (M05 · C2)
  tokenVisitante       String?  @unique(map: "uq_carrito_token_visitante") @map("token_visitante") @db.VarChar(255)
  idUsuario            Int?     @unique(map: "uq_carrito_usuario") @map("id_usuario")
  fechaUltimaActividad DateTime @default(now()) @map("fecha_ultima_actividad") @db.Timestamp(6)

  usuario Usuario?       @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade, map: "fk_carrito_usuario")
  lineas  LineaCarrito[]

  @@map("carrito")
}

/// Línea viva del carrito (HU-CAR-02): variante + color; agregar la misma suma la cantidad (C3)
model LineaCarrito {
  idLineaCarrito Int  @id @default(autoincrement()) @map("id_linea_carrito")
  idCarrito      Int  @map("id_carrito")
  idVariante     Int  @map("id_variante")
  /// Color elegido; null si el producto no lleva color
  idColor        Int? @map("id_color")
  /// Referencia viva del carrito (M21)
  refViva        Int  @default(1) @map("ref_viva")
  cantidad       Int  @default(1)
  /// Cotización aceptada de la que viene la línea; null en una línea normal (M05 · C15)
  idCotizacion   Int?     @map("id_cotizacion")
  /// Precio unitario pactado en la cotización; M06 lo respeta sin descuentos (R3)
  precioAcordado Decimal? @map("precio_acordado") @db.Decimal(12, 2)

  carrito    Carrito     @relation(fields: [idCarrito], references: [idCarrito], onDelete: Cascade, map: "fk_lineacarrito_carrito")
  variante   Variante    @relation(fields: [idVariante], references: [idVariante], onDelete: Cascade, map: "fk_lineacarrito_variante")
  color      Color?      @relation(fields: [idColor], references: [idColor], onDelete: Restrict, map: "fk_lineacarrito_color")
  cotizacion Cotizacion? @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade, map: "fk_lineacarrito_cotizacion")

  // `uq_carrito_variante_color` (UNIQUE NULLS NOT DISTINCT) vive solo en el DDL: Prisma no expresa NULLS NOT DISTINCT.
  @@map("linea_carrito")
}

// =============================================================================
// MÓDULO M21 — COTIZACIONES (esquema 4.18)
// =============================================================================

/// Cotización pedida por un cliente desde su carrito y respondida por el equipo comercial
model Cotizacion {
  idCotizacion       Int              @id @default(autoincrement()) @map("id_cotizacion")
  idUsuario          Int?             @map("id_usuario")
  idRol              Int?             @map("id_rol")
  estado             EstadoCotizacion @default(solicitada)
  fechaCreacion      DateTime         @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  /// COT-000123: columna generada por la base a partir del id; nunca se escribe (R13)
  codigoVisible      String?          @map("codigo_visible") @db.VarChar(20)
  comentarioCliente  String?          @map("comentario_cliente") @db.VarChar(500)
  notaParaCliente    String?          @map("nota_para_cliente") @db.VarChar(1000)
  motivoRechazo      String?          @map("motivo_rechazo") @db.VarChar(500)
  fechaEnvio         DateTime?        @map("fecha_envio") @db.Timestamptz(6)
  /// Último día de vigencia, en hora de Colombia
  fechaVencimiento   DateTime?        @map("fecha_vencimiento") @db.Date
  fechaRespuesta     DateTime?        @map("fecha_respuesta") @db.Timestamptz(6)
  idUsuarioResponde  Int?             @map("id_usuario_responde")
  totalReferencia    Decimal          @default(0) @map("total_referencia") @db.Decimal(14, 2)
  totalAcordado      Decimal?         @map("total_acordado") @db.Decimal(14, 2)
  fechaActualizacion DateTime         @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)

  usuario         Usuario?          @relation("CotizacionCliente", fields: [idUsuario], references: [idUsuario], onDelete: SetNull, map: "fk_cotizacion_usuario")
  rol             Rol?              @relation(fields: [idRol], references: [idRol], onDelete: SetNull, map: "fk_cotizacion_rol")
  usuarioResponde Usuario?          @relation("CotizacionRespondidaPor", fields: [idUsuarioResponde], references: [idUsuario], onDelete: SetNull, map: "fk_cotizacion_usuario_responde")
  lineas            LineaCotizacion[]
  lineasCarrito     LineaCarrito[]
  solicitudesCompra SolicitudCompra[]

  @@index([idUsuario, estado], map: "idx_cotizacion_usuario_estado")
  @@index([estado, fechaCreacion(sort: Desc)], map: "idx_cotizacion_estado_fecha")
  @@map("cotizacion")
}

/// Línea de una cotización: copia del carrito al pedirla y precio acordado
model LineaCotizacion {
  idLineaCotizacion Int      @id @default(autoincrement()) @map("id_linea_cotizacion")
  idCotizacion      Int      @map("id_cotizacion")
  idVariante        Int      @map("id_variante")
  idColor           Int?     @map("id_color")
  cantidad          Int
  precioReferencia  Decimal  @map("precio_referencia") @db.Decimal(12, 2)
  precioAcordado    Decimal? @map("precio_acordado") @db.Decimal(12, 2)
  nombreProducto    String   @map("nombre_producto") @db.VarChar(150)
  marca             String?  @db.VarChar(100)
  medida            String?  @db.VarChar(100)
  sku               String?  @db.VarChar(60)
  colorNombre       String?  @map("color_nombre") @db.VarChar(100)
  colorHexadecimal  String?  @map("color_hexadecimal") @db.Char(7)

  cotizacion Cotizacion @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade, map: "fk_lineacotizacion_cotizacion")
  variante   Variante   @relation(fields: [idVariante], references: [idVariante], onDelete: Restrict, map: "fk_lineacotizacion_variante")
  color      Color?     @relation(fields: [idColor], references: [idColor], onDelete: Restrict, map: "fk_lineacotizacion_color")

  // `uq_lineacotizacion_variante_color` (UNIQUE NULLS NOT DISTINCT) vive solo en el DDL.
  @@index([idCotizacion], map: "idx_lineacotizacion_cotizacion")
  @@map("linea_cotizacion")
}

// =============================================================================
// MÓDULO M06 — PRECIOS, EVENTOS DE DESCUENTO Y CUPONES (esquema 4.13)
// =============================================================================

/// Evento de descuento con calendario (M06 · R4). Fechas y horas son de calendario en hora de Colombia.
model EventoDescuento {
  idEvento           Int           @id @default(autoincrement()) @map("id_evento")
  nombre             String        @db.VarChar(100)
  descripcion        String?       @db.VarChar(500)
  estado             EstadoGeneral @default(activo)
  fechaInicio        DateTime      @map("fecha_inicio") @db.Date
  fechaFin           DateTime?     @map("fecha_fin") @db.Date
  /// Días ISO (1 = lunes … 7 = domingo); vacío = todos los días
  diasSemana         Int[]         @default([]) @map("dias_semana") @db.SmallInt
  /// "HH:mm" en 24 h; null con horaFin null = todo el día
  horaInicio         String?       @map("hora_inicio") @db.VarChar(5)
  horaFin            String?       @map("hora_fin") @db.VarChar(5)
  fechaCreacion      DateTime      @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime      @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?          @map("id_usuario_actualizo")

  usuarioActualizo Usuario?          @relation("EventoDescuentoUsuarioActualizo", fields: [idUsuarioActualizo], references: [idUsuario], onDelete: SetNull, map: "fk_evento_usuario")
  reglas           EventoRegla[]
  exclusiones      EventoExclusion[]

  @@index([estado, fechaInicio, fechaFin], map: "idx_evento_estado_fechas")
  @@map("evento_descuento")
}

/// Regla de un evento: objetivo (null = todo el catálogo) y porcentaje propio (M06 · R5)
model EventoRegla {
  idRegla      Int                 @id @default(autoincrement()) @map("id_regla")
  idEvento     Int                 @map("id_evento")
  tipoObjetivo TipoObjetivoEvento? @map("tipo_objetivo")
  /// Sin FK: apunta a seis tablas distintas (M06 · D10)
  idObjetivo   Int?                @map("id_objetivo")
  porcentaje   Decimal             @db.Decimal(5, 2)
  orden        Int                 @default(0) @db.SmallInt

  evento      EventoDescuento   @relation(fields: [idEvento], references: [idEvento], onDelete: Cascade, map: "fk_evento_regla_evento")
  exclusiones EventoExclusion[]

  @@unique([idRegla, idEvento], map: "uq_evento_regla_evento")
  @@index([idEvento], map: "idx_evento_regla_evento")
  @@index([tipoObjetivo, idObjetivo], map: "idx_evento_regla_objetivo")
  @@map("evento_regla")
}

/// Excepción de una regla (idRegla informado) o de todo el evento (idRegla null) (M06 · R6)
model EventoExclusion {
  idExclusion Int                 @id @default(autoincrement()) @map("id_exclusion")
  idEvento    Int                 @map("id_evento")
  idRegla     Int?                @map("id_regla")
  tipo        TipoExclusionEvento
  idObjetivo  Int                 @map("id_objetivo")

  evento EventoDescuento @relation(fields: [idEvento], references: [idEvento], onDelete: Cascade, map: "fk_evento_exclusion_evento")
  regla  EventoRegla?    @relation(fields: [idRegla, idEvento], references: [idRegla, idEvento], onDelete: Cascade, map: "fk_evento_exclusion_regla")

  @@index([idEvento], map: "idx_evento_exclusion_evento")
  @@index([idRegla], map: "idx_evento_exclusion_regla")
  // Índices únicos parciales (WHERE id_regla IS NULL / IS NOT NULL) solo en el DDL.
  @@map("evento_exclusion")
}

/// Cupón que el cliente escribe en el carrito (M06 · R13, R14). Código en mayúsculas, único.
model Cupon {
  idCupon            Int                @id @default(autoincrement()) @map("id_cupon")
  codigo             String             @unique(map: "uq_cupon_codigo") @db.VarChar(30)
  nombre             String             @db.VarChar(100)
  descripcion        String?            @db.VarChar(500)
  tipoValor          TipoValorDescuento @map("tipo_valor")
  valor              Decimal            @db.Decimal(12, 2)
  montoMinimoCompra  Decimal?           @map("monto_minimo_compra") @db.Decimal(12, 2)
  usosMaximos        Int?               @map("usos_maximos")
  usosPorUsuario     Int?               @map("usos_por_usuario")
  audiencia          AudienciaDescuento @default(todos)
  fechaInicio        DateTime           @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin           DateTime?          @map("fecha_fin") @db.Timestamptz(6)
  estado             EstadoGeneral      @default(activo)
  fechaCreacion      DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime           @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?               @map("id_usuario_actualizo")

  usuarioActualizo Usuario?   @relation("CuponUsuarioActualizo", fields: [idUsuarioActualizo], references: [idUsuario], onDelete: SetNull, map: "fk_cupon_usuario")
  usos             CuponUso[]

  @@index([estado, fechaInicio, fechaFin], map: "idx_cupon_estado_fechas")
  @@map("cupon")
}

/// Un uso de cupón por orden; `referencia` única hace idempotente el registro (M06 · R15)
model CuponUso {
  idCuponUso       Int       @id @default(autoincrement()) @map("id_cupon_uso")
  idCupon          Int       @map("id_cupon")
  idUsuario        Int?      @map("id_usuario")
  referencia       String    @unique(map: "uq_cupon_uso_referencia") @db.VarChar(100)
  importeDescuento Decimal   @map("importe_descuento") @db.Decimal(12, 2)
  fecha            DateTime  @default(now()) @db.Timestamptz(6)
  /// Se llena al cancelarse la orden; los liberados no cuentan para los límites
  liberadoEn       DateTime? @map("liberado_en") @db.Timestamptz(6)

  cupon   Cupon    @relation(fields: [idCupon], references: [idCupon], onDelete: Restrict, map: "fk_cupon_uso_cupon")
  usuario Usuario? @relation(fields: [idUsuario], references: [idUsuario], onDelete: SetNull, map: "fk_cupon_uso_usuario")

  // Índice parcial (idCupon, idUsuario) WHERE liberado_en IS NULL solo en el DDL.
  @@map("cupon_uso")
}

// =============================================================================
// MÓDULO M15 — ATENCIÓN AL CLIENTE (esquema 4.11)
// Contrato: contracts/m15-atencion.contract.ts
// Las preguntas frecuentes son de M16 (`faq_entrada`): M15 las consume por puerto.
// =============================================================================

/// Pregunta frecuente administrable, agrupada por tema y ordenada (M15 · HU-ATC-01)
/// Solicitud del formulario de contacto dirigida al administrador (M15 · HU-ATC-02).
/// Los datos de contacto no se guardan: se leen de la cuenta al mostrarla (RF-ATC-02-04).
model SolicitudContacto {
  idSolicitud       String                  @id @default(uuid()) @map("id_solicitud") @db.Uuid
  idUsuario         Int                     @map("id_usuario")
  tipo              TipoSolicitudContacto
  descripcion       String                  @db.VarChar(2000)
  estado            EstadoSolicitudContacto @default(en_revision)
  calificacion      Int?                    @db.SmallInt
  fechaCalificacion DateTime?               @map("fecha_calificacion") @db.Timestamptz(6)
  fechaCreacion     DateTime                @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  usuario  Usuario                    @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade, map: "fk_solicitud_contacto_usuario")
  mensajes MensajeSolicitudContacto[]

  @@index([idUsuario], map: "idx_solicitud_contacto_usuario")
  @@index([estado, fechaCreacion(sort: Desc)], map: "idx_solicitud_contacto_estado_fecha")
  @@map("solicitud_contacto")
}

/// Mensaje dentro del hilo de conversación de una solicitud de contacto (M15 · R12)
model MensajeSolicitudContacto {
  idMensaje     String                   @id @default(uuid()) @map("id_mensaje") @db.Uuid
  idSolicitud   String                   @map("id_solicitud") @db.Uuid
  idAutor       Int                      @map("id_autor")
  rolAutor      RolAutorMensajeSolicitud @map("rol_autor")
  contenido     String                   @db.VarChar(2000)
  fechaCreacion DateTime                 @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  solicitud SolicitudContacto @relation(fields: [idSolicitud], references: [idSolicitud], onDelete: Cascade, map: "fk_mensaje_solicitud_contacto")
  autor     Usuario           @relation(fields: [idAutor], references: [idUsuario], onDelete: Cascade, map: "fk_mensaje_solicitud_autor")

  @@index([idSolicitud, fechaCreacion(sort: Asc)], map: "idx_mensaje_solicitud_fecha")
  @@index([idAutor], map: "idx_mensaje_solicitud_autor")
  @@map("mensaje_solicitud_contacto")
}

/// Franja de atención humana de un día de la semana (M15 · HU-ATC-04).
/// `abierto = false` cierra el día completo y deja las horas en null.
model HorarioAtencion {
  idHorario          Int       @id @default(autoincrement()) @map("id_horario")
  diaSemana          DiaSemana @unique @map("dia_semana")
  abierto            Boolean   @default(true)
  /// Hora local "HH:mm" en 24h; null cuando el día está cerrado
  horaInicio         String?   @map("hora_inicio") @db.VarChar(5)
  horaFin            String?   @map("hora_fin") @db.VarChar(5)
  fechaActualizacion DateTime  @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?      @map("id_usuario_actualizo")

  @@map("horario_atencion")
}

/// Destino del botón de contacto directo por WhatsApp; fila única (M15 · HU-ATC-03)
model ConfiguracionAtencionWhatsapp {
  idConfiguracion    Int      @id @default(1) @map("id_configuracion") @db.SmallInt
  /// URL completa (hoy el canal de difusión) o número de WhatsApp Business cuando exista
  destino            String   @db.VarChar(300)
  mensajeBase        String?  @map("mensaje_base") @db.VarChar(300)
  fechaActualizacion DateTime @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?     @map("id_usuario_actualizo")

  @@map("configuracion_atencion_whatsapp")
}

// =============================================================================
// MÓDULO M01 — CATÁLOGO (esquema 4.3)
// Reglas: docs/02_MODULOS_FUNCIONALES/M01_REGLAS_ADICIONALES.md
// =============================================================================

/// Nivel 1 de la clasificación: qué ES el producto (RF-CAT-01-01)
model Categoria {
  idCategoria Int           @id @default(autoincrement()) @map("id_categoria")
  nombre      String        @unique @db.VarChar(100)
  orden       Int           @default(0)
  estado      EstadoGeneral @default(activo)

  subcategorias            Subcategoria[]
  productosComplementarios Producto[]     @relation("CategoriaComplementaria")
  subcategoriasComplementarias Subcategoria[] @relation("SubcategoriaCategoriaComplementaria")
  imagenInicio             ImagenCategoriaInicio?

  @@map("categoria")
}

/// Nivel 2 y último de la clasificación (RF-CAT-01-02)
model Subcategoria {
  idSubcategoria Int           @id @default(autoincrement()) @map("id_subcategoria")
  idCategoria    Int           @map("id_categoria")
  nombre         String        @db.VarChar(100)
  orden          Int           @default(0)
  estado         EstadoGeneral @default(activo)
  /// Categoría de la que se sugieren complementarios a sus productos sin una propia (RF-CAT-08-01)
  idCategoriaComplementaria Int? @map("id_categoria_complementaria")

  categoria Categoria  @relation(fields: [idCategoria], references: [idCategoria], onDelete: Restrict, map: "fk_subcategoria_categoria")
  categoriaComplementaria Categoria? @relation("SubcategoriaCategoriaComplementaria", fields: [idCategoriaComplementaria], references: [idCategoria], onDelete: SetNull, map: "fk_subcategoria_categoria_complementaria")
  productos Producto[]

  @@unique([idCategoria, nombre], map: "uq_subcategoria_nombre_categoria")
  @@index([idCategoria], map: "idx_subcategoria_categoria")
  @@map("subcategoria")
}

/// Dónde se aplica un producto (etiqueta N:M)
model Superficie {
  idSuperficie Int           @id @default(autoincrement()) @map("id_superficie")
  nombre       String        @unique @db.VarChar(100)
  orden        Int           @default(0)
  estado       EstadoGeneral @default(activo)

  productos ProductoSuperficie[]

  @@map("superficie")
}

/// Marca (HU-CAT-04). Logotipo en bytes, máximo 5 MB, jpeg/png/webp
model Marca {
  idMarca          Int           @id @default(autoincrement()) @map("id_marca")
  nombre           String        @unique @db.VarChar(100)
  logotipo         Bytes
  logotipoMimeType String        @map("logotipo_mime_type") @db.VarChar(50)
  estado           EstadoGeneral @default(activo)

  lineas    Linea[]
  colores   Color[]
  productos Producto[]

  @@map("marca")
}

/// Línea comercial de una marca (HU-CAT-11); opcional en el producto
model Linea {
  idLinea       Int           @id @default(autoincrement()) @map("id_linea")
  idMarca       Int           @map("id_marca")
  nombre        String        @db.VarChar(100)
  gamaComercial String?       @map("gama_comercial") @db.VarChar(100)
  estado        EstadoGeneral @default(activo)

  marca     Marca      @relation(fields: [idMarca], references: [idMarca], onDelete: Restrict, map: "fk_linea_marca")
  productos Producto[]

  @@unique([idMarca, nombre], map: "uq_linea_nombre_marca")
  @@unique([idLinea, idMarca], map: "uq_linea_id_marca")
  @@index([idMarca], map: "idx_linea_marca")
  @@map("linea")
}

/// Tipo de resina (RF-CAT-02-04)
model TipoResina {
  idTipoResina Int           @id @default(autoincrement()) @map("id_tipo_resina")
  nombre       String        @unique @db.VarChar(100)
  estado       EstadoGeneral @default(activo)

  fichas FichaRecubrimiento[]

  @@map("tipo_resina")
}

/// Acabado (Brillante, Mate, Semimate…)
model Acabado {
  idAcabado Int           @id @default(autoincrement()) @map("id_acabado")
  nombre    String        @unique @db.VarChar(50)
  orden     Int           @default(0)
  estado    EstadoGeneral @default(activo)

  colores   Color[]
  productos ProductoAcabado[]

  @@map("acabado")
}

/// Base de colorimetría (Tint, Deep, Pastel, Accent); global
model Base {
  idBase Int           @id @default(autoincrement()) @map("id_base")
  nombre String        @unique @db.VarChar(50)
  orden  Int           @default(0)
  estado EstadoGeneral @default(activo)

  colores   Color[]
  productos ProductoBase[]

  @@map("base")
}

/// Familia cromática del selector de color (RF-CAT-05-03)
model FamiliaColor {
  idFamiliaColor Int           @id @default(autoincrement()) @map("id_familia_color")
  nombre         String        @unique @db.VarChar(50)
  hexadecimal    String        @db.Char(7)
  orden          Int           @default(0)
  estado         EstadoGeneral @default(activo)

  colores Color[]

  @@map("familia_color")
}

/// Unidad de una medida (galón, litro, pulgada…)
model TipoMedida {
  idTipoMedida        Int           @id @default(autoincrement()) @map("id_tipo_medida")
  nombre              String        @unique @db.VarChar(50)
  abreviatura         String        @unique @db.VarChar(10)
  /// Galones que equivale una unidad (litro = 0,264172052); null si no es de volumen
  equivalenciaGalones Decimal?      @map("equivalencia_galones") @db.Decimal(12, 9)
  estado              EstadoGeneral @default(activo)

  medidas Medida[]

  @@map("tipo_medida")
}

/// Medida vendible: valor + tipo de medida
model Medida {
  idMedida     Int           @id @default(autoincrement()) @map("id_medida")
  idTipoMedida Int           @map("id_tipo_medida")
  valor        Decimal       @db.Decimal(12, 3)
  nombre       String        @unique @db.VarChar(60)
  estado       EstadoGeneral @default(activo)
  /// Imagen opcional de la medida (ej. silueta del envase)
  imagen         Bytes?
  imagenMimeType String?       @map("imagen_mime_type") @db.VarChar(50)

  tipoMedida TipoMedida @relation(fields: [idTipoMedida], references: [idTipoMedida], onDelete: Restrict, map: "fk_medida_tipo")
  variantes  Variante[]

  @@unique([idTipoMedida, valor], map: "uq_medida_valor_tipo")
  @@index([idTipoMedida], map: "idx_medida_tipo")
  @@map("medida")
}

/// Color de una marca (HU-CAT-05). Base opcional pero esencial; acabado obligatorio
model Color {
  idColor        Int           @id @default(autoincrement()) @map("id_color")
  idMarca        Int           @map("id_marca")
  nombre         String        @db.VarChar(100)
  codigo         String?       @db.VarChar(60)
  idBase         Int?          @map("id_base")
  idAcabado      Int           @map("id_acabado")
  idFamiliaColor Int?          @map("id_familia_color")
  hexadecimal    String        @db.Char(7)
  cieL           Decimal?      @map("cie_l") @db.Decimal(6, 3)
  cieA           Decimal?      @map("cie_a") @db.Decimal(6, 3)
  cieB           Decimal?      @map("cie_b") @db.Decimal(6, 3)
  estado         EstadoGeneral @default(activo)

  marca     Marca           @relation(fields: [idMarca], references: [idMarca], onDelete: Restrict, map: "fk_color_marca")
  base      Base?           @relation(fields: [idBase], references: [idBase], onDelete: Restrict, map: "fk_color_base")
  acabado   Acabado         @relation(fields: [idAcabado], references: [idAcabado], onDelete: Restrict, map: "fk_color_acabado")
  familia   FamiliaColor?   @relation(fields: [idFamiliaColor], references: [idFamiliaColor], onDelete: Restrict, map: "fk_color_familia")
  productos ProductoColor[]
  imagenes  Imagen[]
  lineasCarrito LineaCarrito[]
  lineasCotizacion LineaCotizacion[]

  @@unique([idMarca, nombre, idAcabado], map: "uq_color_nombre_marca_acabado")
  @@index([idMarca], map: "idx_color_marca")
  @@index([idBase, idAcabado], map: "idx_color_base_acabado")
  @@index([idFamiliaColor], map: "idx_color_familia")
  @@map("color")
}

/// Producto (HU-CAT-02): marca → línea (opcional) → producto
model Producto {
  idProducto                Int           @id @default(autoincrement()) @map("id_producto")
  idMarca                   Int           @map("id_marca")
  idLinea                   Int?          @map("id_linea")
  idSubcategoria            Int           @map("id_subcategoria")
  nombre                    String        @db.VarChar(150)
  descripcion               String?
  usoInterior               Boolean       @default(false) @map("uso_interior")
  usoExterior               Boolean       @default(false) @map("uso_exterior")
  estado                    EstadoGeneral @default(activo)
  publicado                 Boolean       @default(false)
  idCategoriaComplementaria Int?          @map("id_categoria_complementaria")
  /// Combo (HU-CAT-13): paquete a precio propio con una única variante; su venta se limita por existencia
  esCombo                   Boolean       @default(false) @map("es_combo")
  /// M06 no le aplica descuentos (RF-CAT-13-01)
  excluidoDeDescuentos      Boolean       @default(false) @map("excluido_de_descuentos")
  fechaCreacion             DateTime      @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  marca                   Marca        @relation(fields: [idMarca], references: [idMarca], onDelete: Restrict, map: "fk_producto_marca")
  /// FK compuesta: la línea debe ser de la misma marca (RF-CAT-11-02)
  linea                   Linea?       @relation(fields: [idLinea, idMarca], references: [idLinea, idMarca], onDelete: Restrict, map: "fk_producto_linea_marca")
  subcategoria            Subcategoria @relation(fields: [idSubcategoria], references: [idSubcategoria], onDelete: Restrict, map: "fk_producto_subcategoria")
  categoriaComplementaria Categoria?   @relation("CategoriaComplementaria", fields: [idCategoriaComplementaria], references: [idCategoria], onDelete: SetNull, map: "fk_producto_categoria_complementaria")

  ficha           FichaRecubrimiento?
  superficies     ProductoSuperficie[]
  acabados        ProductoAcabado[]
  bases           ProductoBase[]
  coloresFabrica  ProductoColor[]
  caracteristicas ProductoCaracteristica[]
  variantes       Variante[]
  imagenes        Imagen[]
  combos          Combo[]

  @@unique([idMarca, nombre], map: "uq_producto_nombre_marca")
  @@index([idLinea], map: "idx_producto_linea")
  @@index([idMarca], map: "idx_producto_marca")
  @@index([idSubcategoria], map: "idx_producto_subcategoria")
  @@index([idCategoriaComplementaria], map: "idx_producto_cat_complementaria")
  @@map("producto")
}

/// Datos técnicos de recubrimientos (HU-CAT-10); 1:1 opcional con producto
model FichaRecubrimiento {
  idProducto     Int      @id @map("id_producto")
  idTipoResina   Int      @map("id_tipo_resina")
  /// Tipo 1, 2 o 3 del fabricante (1 = gama alta)
  tipoCalidad    Int?     @map("tipo_calidad") @db.SmallInt
  /// m² por galón
  rendimientoMin Decimal? @map("rendimiento_min") @db.Decimal(8, 2)
  rendimientoMax Decimal? @map("rendimiento_max") @db.Decimal(8, 2)
  /// Manos con las que se logra el rendimiento
  manos          Int?     @db.SmallInt

  producto   Producto   @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, map: "fk_ficha_producto")
  tipoResina TipoResina @relation(fields: [idTipoResina], references: [idTipoResina], onDelete: Restrict, map: "fk_ficha_resina")

  @@index([idTipoResina], map: "idx_ficha_resina")
  @@map("ficha_recubrimiento")
}

model ProductoSuperficie {
  idProducto   Int @map("id_producto")
  idSuperficie Int @map("id_superficie")

  producto   Producto   @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, map: "fk_prodsup_producto")
  superficie Superficie @relation(fields: [idSuperficie], references: [idSuperficie], onDelete: Restrict, map: "fk_prodsup_superficie")

  @@id([idProducto, idSuperficie])
  @@index([idSuperficie], map: "idx_prodsup_superficie")
  @@map("producto_superficie")
}

/// Acabados del producto: filtran los colores de su carta
model ProductoAcabado {
  idProducto Int @map("id_producto")
  idAcabado  Int @map("id_acabado")

  producto Producto @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, map: "fk_prodacab_producto")
  acabado  Acabado  @relation(fields: [idAcabado], references: [idAcabado], onDelete: Restrict, map: "fk_prodacab_acabado")

  @@id([idProducto, idAcabado])
  @@index([idAcabado], map: "idx_prodacab_acabado")
  @@map("producto_acabado")
}

/// Bases del producto entonable: definen su carta (RF-CAT-12-02)
model ProductoBase {
  idProducto Int @map("id_producto")
  idBase     Int @map("id_base")

  producto Producto @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, map: "fk_prodbase_producto")
  base     Base     @relation(fields: [idBase], references: [idBase], onDelete: Restrict, map: "fk_prodbase_base")

  @@id([idProducto, idBase])
  @@index([idBase], map: "idx_prodbase_base")
  @@map("producto_base")
}

/// Colores exclusivos o de fábrica del producto
model ProductoColor {
  idProducto Int @map("id_producto")
  idColor    Int @map("id_color")

  producto Producto @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, map: "fk_prodcolor_producto")
  color    Color    @relation(fields: [idColor], references: [idColor], onDelete: Restrict, map: "fk_prodcolor_color")

  @@id([idProducto, idColor])
  @@index([idColor], map: "idx_prodcolor_color")
  @@map("producto_color")
}

/// Atributo técnico nombre/valor (HU-CAT-10)
model ProductoCaracteristica {
  idCaracteristica Int    @id @default(autoincrement()) @map("id_caracteristica")
  idProducto       Int    @map("id_producto")
  nombre           String @db.VarChar(100)
  valor            String @db.VarChar(255)
  orden            Int    @default(0)

  producto Producto @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, map: "fk_prodcaract_producto")

  @@unique([idProducto, nombre], map: "uq_prodcaract_nombre")
  @@map("producto_caracteristica")
}

/// Variante vendible = producto + medida, con su precio. El color se elige en la venta
model Variante {
  idVariante            Int            @id @default(autoincrement()) @map("id_variante")
  idProducto            Int            @map("id_producto")
  idMedida              Int            @map("id_medida")
  sku                   String         @unique @db.VarChar(60)
  precioVigente         Decimal        @map("precio_vigente") @db.Decimal(12, 2)
  /// Solo referencial; no bloquea ventas (M13)
  existenciaReferencial Int            @default(0) @map("existencia_referencial")
  /// Código de SAMIT para la integración futura
  codigoProveedor       String?        @unique(map: "uq_variante_codigo_proveedor") @map("codigo_proveedor") @db.VarChar(100)
  estado                EstadoProducto @default(activo)

  producto Producto        @relation(fields: [idProducto], references: [idProducto], onDelete: Restrict, map: "fk_variante_producto")
  medida   Medida          @relation(fields: [idMedida], references: [idMedida], onDelete: Restrict, map: "fk_variante_medida")
  imagenes Imagen[]
  combos   VarianteCombo[]
  ajustes  AjusteInventario[]
  lineasCarrito LineaCarrito[]
  lineasCotizacion LineaCotizacion[]

  @@unique([idProducto, idMedida], map: "uq_variante_producto_medida")
  @@index([idProducto], map: "idx_variante_producto")
  @@index([idMedida], map: "idx_variante_medida")
  @@index([estado], map: "idx_variante_estado")
  @@map("variante")
}

/// Imagen de un producto (HU-CAT-07); opcionalmente de una variante o un color
model Imagen {
  idImagen    Int     @id @default(autoincrement()) @map("id_imagen")
  idProducto  Int     @map("id_producto")
  idVariante  Int?    @map("id_variante")
  idColor     Int?    @map("id_color")
  datos       Bytes
  mimeType    String  @map("mime_type") @db.VarChar(50)
  orden       Int     @default(0)
  esPrincipal Boolean @default(false) @map("es_principal")
  /// Miniatura de 320 px en WebP para los listados; null en imágenes anteriores (RNF-CAT-07-01)
  miniatura   Bytes?
  /// Versión de 960 px en WebP para la ficha; null en imágenes anteriores
  mediana     Bytes?

  producto Producto  @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, map: "fk_imagen_producto")
  variante Variante? @relation(fields: [idVariante], references: [idVariante], onDelete: Cascade, map: "fk_imagen_variante")
  color    Color?    @relation(fields: [idColor], references: [idColor], onDelete: SetNull, map: "fk_imagen_color")

  @@index([idProducto], map: "idx_imagen_producto")
  @@index([idVariante], map: "idx_imagen_variante")
  @@index([idColor], map: "idx_imagen_color")
  @@map("imagen")
}

/// Combo comercial (HU-CAT-13); pendiente de rediseño
model Combo {
  idCombo    Int @id @default(autoincrement()) @map("id_combo")
  idProducto Int @map("id_producto")

  producto  Producto        @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, map: "fk_combo_producto")
  variantes VarianteCombo[]

  @@index([idProducto], map: "idx_combo_producto")
  @@map("combo")
}

model VarianteCombo {
  idVarianteCombo Int @id @default(autoincrement()) @map("id_variante_combo")
  idVariante      Int @map("id_variante")
  idCombo         Int @map("id_combo")
  cantidad        Int @default(1)

  variante Variante @relation(fields: [idVariante], references: [idVariante], onDelete: Cascade, map: "fk_varcombo_variante")
  combo    Combo    @relation(fields: [idCombo], references: [idCombo], onDelete: Cascade, map: "fk_varcombo_combo")

  @@unique([idVariante, idCombo], map: "uq_variante_combo")
  @@index([idVariante], map: "idx_varcombo_variante")
  @@index([idCombo], map: "idx_varcombo_combo")
  @@map("variante_combo")
}

// =============================================================================
// MÓDULO M08 — ORDEN DE VENTA (histórico inmutable)
// =============================================================================

/// Ciclo de vida de la orden (M08 · HU-ORD-03). La base nueva no incluye el valor legado `pendiente`.
enum EstadoOrden {
  orden_confirmada
  revision_disponibilidad
  en_preparacion
  preparada
  despachado
  entregado
  cancelado
  devuelto

  @@map("enum_estado_orden")
}

/// Modo de entrega congelado en la orden (M08 · RF-ORD-03-06)
enum ModoEntrega {
  domicilio
  recogida

  @@map("enum_modo_entrega")
}

/// Procedencia de la orden (M08 · RF-ORD-01-03)
enum OrigenOrden {
  carrito
  cotizacion

  @@map("enum_origen_orden")
}

/// Cabecera de la orden. `idCotizacion` no lleva relación Prisma: M21 aún no tiene modelo (la FK existe en el DDL).
model Orden {
  idOrden            Int          @id @default(autoincrement()) @map("id_orden")
  codigoVisible      String       @unique @map("codigo_visible") @db.VarChar(50)
  idUsuario          Int          @map("id_usuario")
  origen             OrigenOrden  @default(carrito)
  idCotizacion       Int?         @map("id_cotizacion")
  carritoOCotizacion String?      @map("carrito_o_cotizacion") @db.VarChar(50)
  estado             EstadoOrden  @default(orden_confirmada)
  transaccionPagoId  String?      @unique @map("transaccion_pago_id") @db.VarChar(100)
  codigoSolicitud    String?      @unique(map: "uq_orden_codigo_solicitud") @map("codigo_solicitud") @db.VarChar(20)
  modoEntrega        ModoEntrega? @map("modo_entrega")
  costoEntrega       Decimal      @default(0) @map("costo_entrega") @db.Decimal(12, 2)
  direccion          String?
  subTotal           Decimal      @default(0) @map("sub_total") @db.Decimal(12, 2)
  descuento          Decimal      @default(0) @db.Decimal(12, 2)
  total              Decimal      @default(0) @db.Decimal(12, 2)
  baseSinImpuesto    Decimal?     @map("base_sin_impuesto") @db.Decimal(12, 2)
  importeIva         Decimal?     @map("importe_iva") @db.Decimal(12, 2)
  tasaIva            Decimal?     @map("tasa_iva") @db.Decimal(5, 2)
  observaciones      String?
  fecha              DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date

  usuario   Usuario                @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Cascade, onDelete: Restrict, map: "fk_orden_usuario")
  lineas    LineaOrden[]
  historial HistorialEstadoOrden[]
  notas     NotaOrden[]
  contactos ContactoOrden[]
  solicitudesPostventa SolicitudPostventa[]

  @@index([idUsuario])
  @@index([estado])
  @@map("orden")
}

/// Copia congelada de lo comprado. `idVarianteRef` sin FK a propósito (ADR-05 de M08).
model LineaOrden {
  idLineaOrden    Int      @id @default(autoincrement()) @map("id_linea_orden")
  idOrden         Int      @map("id_orden")
  nombreProducto  String   @map("nombre_producto") @db.VarChar(150)
  varianteCopia   String   @map("variante_copia") @db.VarChar(150)
  precioAplicado  Decimal  @map("precio_aplicado") @db.Decimal(12, 2)
  cantidad        Int      @default(1)
  colorSolicitado String?  @map("color_solicitado") @db.VarChar(150)
  precioInicial   Decimal? @map("precio_inicial") @db.Decimal(12, 2)
  idVarianteRef   Int?     @map("id_variante_ref")
  esEntonado      Boolean  @default(false) @map("es_entonado")
  baseConsumida   String?  @map("base_consumida") @db.VarChar(150)
  skuVendido      String?  @map("sku_vendido") @db.VarChar(100)

  orden      Orden                 @relation(fields: [idOrden], references: [idOrden], onUpdate: Cascade, onDelete: Restrict, map: "fk_lineaorden_orden")
  descuentos LineaOrdenDescuento[]
  lineasPostventa LineaSolicitudPostventa[]

  @@index([idOrden])
  @@map("linea_orden")
}

/// Desglose de descuentos de una línea; solo inserción (RF-ORD-02-02).
model LineaOrdenDescuento {
  idLineaOrdenDescuento Int      @id @default(autoincrement()) @map("id_linea_orden_descuento")
  idLineaOrden          Int      @map("id_linea_orden")
  ordenAplicacion       Int      @map("orden_aplicacion") @db.SmallInt
  origen                String   @db.VarChar(150)
  porcentaje            Decimal? @db.Decimal(5, 2)
  importe               Decimal  @db.Decimal(12, 2)

  linea LineaOrden @relation(fields: [idLineaOrden], references: [idLineaOrden], onUpdate: Cascade, onDelete: Restrict, map: "fk_lod_linea_orden")

  @@unique([idLineaOrden, ordenAplicacion], map: "uq_lod_orden_aplicacion")
  @@map("linea_orden_descuento")
}

/// Consecutivos corridos sin huecos por tipo de documento (`orden` → PC-AAAA-NNNNN).
model Consecutivo {
  idConsecutivo Int    @id @default(autoincrement()) @map("id_consecutivo")
  nombre        String @unique @db.VarChar(30)
  ultimoValor   BigInt @default(0) @map("ultimo_valor")

  @@map("consecutivo")
}

/// Historia inmutable de transiciones; `idUsuarioAutor` null = transición automática del sistema.
model HistorialEstadoOrden {
  idHistorialEstadoOrden Int          @id @default(autoincrement()) @map("id_historial_estado_orden")
  idOrden                Int          @map("id_orden")
  estadoAnterior         EstadoOrden? @map("estado_anterior")
  estadoNuevo            EstadoOrden  @map("estado_nuevo")
  idUsuarioAutor         Int?         @map("id_usuario_autor")
  motivo                 String?
  referenciaExterna      String?      @map("referencia_externa") @db.VarChar(150)
  fecha                  DateTime     @default(now()) @db.Timestamptz(6)

  orden Orden    @relation(fields: [idOrden], references: [idOrden], onUpdate: Cascade, onDelete: Restrict, map: "fk_historial_estado_orden")
  autor Usuario? @relation(fields: [idUsuarioAutor], references: [idUsuario], onUpdate: Cascade, onDelete: Restrict, map: "fk_historial_estado_autor")

  @@index([idOrden])
  @@map("historial_estado_orden")
}

/// Notas internas del personal; solo inserción, nunca visibles al cliente (RF-ORD-10).
model NotaOrden {
  idNotaOrden    Int      @id @default(autoincrement()) @map("id_nota_orden")
  idOrden        Int      @map("id_orden")
  idUsuarioAutor Int      @map("id_usuario_autor")
  texto          String
  fecha          DateTime @default(now()) @db.Timestamptz(6)

  orden Orden   @relation(fields: [idOrden], references: [idOrden], onUpdate: Cascade, onDelete: Restrict, map: "fk_nota_orden_orden")
  autor Usuario @relation(fields: [idUsuarioAutor], references: [idUsuario], onUpdate: Cascade, onDelete: Restrict, map: "fk_nota_orden_autor")

  @@index([idOrden])
  @@map("nota_orden")
}

/// Contactos con el cliente iniciados desde la orden; solo inserción (RF-ORD-09-02).
model ContactoOrden {
  idContactoOrden Int      @id @default(autoincrement()) @map("id_contacto_orden")
  idOrden         Int      @map("id_orden")
  idUsuarioAutor  Int      @map("id_usuario_autor")
  medio           String   @db.VarChar(30)
  detalle         String?
  fecha           DateTime @default(now()) @db.Timestamptz(6)

  orden Orden   @relation(fields: [idOrden], references: [idOrden], onUpdate: Cascade, onDelete: Restrict, map: "fk_contacto_orden_orden")
  autor Usuario @relation(fields: [idUsuarioAutor], references: [idUsuario], onUpdate: Cascade, onDelete: Restrict, map: "fk_contacto_orden_autor")

  @@index([idOrden])
  @@map("contacto_orden")
}

// =============================================================================
// MÓDULO M11 — POSTVENTA (DEVOLUCIONES, REEMBOLSOS Y CANCELACIONES)
// =============================================================================

enum TipoPostventa {
  cancelacion
  devolucion
  garantia

  @@map("enum_tipo_postventa")
}

enum EstadoPostventa {
  solicitada
  en_revision
  aprobada
  rechazada
  reembolsada

  @@map("enum_estado_postventa")
}

enum MetodoReembolso {
  transferencia_bancaria
  reverso_pasarela
  saldo_tienda
  efectivo

  @@map("enum_metodo_reembolso")
}

enum MotivoRechazoPostventa {
  fuera_de_plazo
  producto_entonado
  producto_abierto_o_danado
  evidencia_insuficiente
  politica_no_cumplida
  otro

  @@map("enum_motivo_rechazo_postventa")
}

/// Cabecera de trámites de postventa: cancelaciones, devoluciones y garantías (M11)
model SolicitudPostventa {
  idSolicitudPostventa     Int                     @id @default(autoincrement()) @map("id_solicitud_postventa")
  codigoVisible            String                  @unique @map("codigo_visible") @db.VarChar(50)
  idOrden                  Int                     @map("id_orden")
  idUsuario                Int                     @map("id_usuario")
  tipo                     TipoPostventa
  estado                   EstadoPostventa         @default(solicitada)
  motivoGeneral            String                  @map("motivo_general")
  observacionesResolucion  String?                 @map("observaciones_resolucion")
  motivoRechazo            MotivoRechazoPostventa? @map("motivo_rechazo")
  idEmpleadoResuelve       Int?                    @map("id_empleado_resuelve")
  totalReembolso           Decimal                 @default(0) @map("total_reembolso") @db.Decimal(12, 2)
  metodoReembolso          MetodoReembolso?        @map("metodo_reembolso")
  referenciaReembolso      String?                 @map("referencia_reembolso") @db.VarChar(100)
  comprobanteUrl           String?                 @map("comprobante_url") @db.VarChar(255)
  datosBancarios           Json?                   @map("datos_bancarios")
  evidenciaUrls            Json?                   @map("evidencia_urls")
  fechaSolicitud           DateTime                @default(now()) @map("fecha_solicitud") @db.Timestamptz(6)
  fechaResolucion          DateTime?               @map("fecha_resolucion") @db.Timestamptz(6)
  fechaReembolso           DateTime?               @map("fecha_reembolso") @db.Timestamptz(6)

  orden            Orden                      @relation(fields: [idOrden], references: [idOrden], onUpdate: Cascade, onDelete: Restrict, map: "fk_postventa_orden")
  usuario          Usuario                    @relation("SolicitudesPostventaUsuario", fields: [idUsuario], references: [idUsuario], onUpdate: Cascade, onDelete: Restrict, map: "fk_postventa_usuario")
  empleadoResuelve Usuario?                   @relation("SolicitudesPostventaResueltas", fields: [idEmpleadoResuelve], references: [idUsuario], onUpdate: Cascade, onDelete: SetNull, map: "fk_postventa_empleado")
  lineas           LineaSolicitudPostventa[]
  historial        HistorialEstadoPostventa[]

  @@index([idOrden])
  @@index([idUsuario, fechaSolicitud(sort: Desc)])
  @@index([estado, fechaSolicitud(sort: Desc)])
  @@index([tipo])
  @@map("solicitud_postventa")
}

/// Desglose de variantes y cantidades devueltas por el cliente (M11 · HU-POS-02)
model LineaSolicitudPostventa {
  idLineaSolicitudPostventa Int      @id @default(autoincrement()) @map("id_linea_solicitud_postventa")
  idSolicitudPostventa      Int      @map("id_solicitud_postventa")
  idLineaOrden              Int      @map("id_linea_orden")
  cantidad                  Int      @default(1)
  precioUnitario            Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  subtotal                  Decimal  @db.Decimal(12, 2)
  motivoEspecifico          String?  @map("motivo_especifico") @db.VarChar(300)

  solicitud  SolicitudPostventa @relation(fields: [idSolicitudPostventa], references: [idSolicitudPostventa], onUpdate: Cascade, onDelete: Cascade, map: "fk_lsp_solicitud")
  lineaOrden LineaOrden         @relation(fields: [idLineaOrden], references: [idLineaOrden], onUpdate: Cascade, onDelete: Restrict, map: "fk_lsp_linea_orden")

  @@index([idSolicitudPostventa])
  @@index([idLineaOrden])
  @@map("linea_solicitud_postventa")
}

/// Trazabilidad inmutable de los cambios de estado del trámite postventa (M11 · HU-POS-05)
model HistorialEstadoPostventa {
  idHistorialEstadoPostventa Int              @id @default(autoincrement()) @map("id_historial_estado_postventa")
  idSolicitudPostventa       Int              @map("id_solicitud_postventa")
  estadoAnterior             EstadoPostventa? @map("estado_anterior")
  estadoNuevo                EstadoPostventa  @map("estado_nuevo")
  idUsuarioAutor             Int?             @map("id_usuario_autor")
  motivo                     String?
  fecha                      DateTime         @default(now()) @db.Timestamptz(6)

  solicitud SolicitudPostventa @relation(fields: [idSolicitudPostventa], references: [idSolicitudPostventa], onUpdate: Cascade, onDelete: Cascade, map: "fk_hep_solicitud")
  autor     Usuario?           @relation(fields: [idUsuarioAutor], references: [idUsuario], onUpdate: Cascade, onDelete: SetNull, map: "fk_hep_autor")

  @@index([idSolicitudPostventa])
  @@map("historial_estado_postventa")
}

// =============================================================================
// MÓDULO M16 — CONTENIDO INSTITUCIONAL Y CENTRO DE AYUDA (HU-CON-01 a HU-CON-04)
// =============================================================================

/// Página institucional administrable (Sobre Nosotros, Términos, Privacidad, Envíos)
model PaginaInstitucional {
  idPagina           Int             @id @default(autoincrement()) @map("id_pagina")
  slug               String          @unique @db.VarChar(120)
  titulo             String          @db.VarChar(160)
  resumen            String?         @db.VarChar(300)
  cuerpoMarkdown     String          @map("cuerpo_markdown")
  estado             EstadoContenido @default(borrador)
  idAutor            Int?            @map("id_autor")
  fechaCreacion      DateTime        @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime        @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)

  autor Usuario? @relation("PaginaInstitucionalAutor", fields: [idAutor], references: [idUsuario], onDelete: SetNull, map: "fk_pagina_institucional_autor")

  @@index([estado], map: "idx_pagina_institucional_estado")
  @@index([idAutor], map: "idx_pagina_institucional_autor")
  @@map("pagina_institucional")
}

/// Datos de contacto y redes del sitio (pie de página): una sola fila, id = 1; todo opcional (M16)
model ContactoInstitucional {
  idContacto         Int      @id @default(1) @map("id_contacto") @db.SmallInt
  direccion          String?  @db.VarChar(200)
  telefono           String?  @db.VarChar(30)
  correo             String?  @db.VarChar(150)
  facebook           String?  @db.VarChar(300)
  instagram          String?  @db.VarChar(300)
  youtube            String?  @db.VarChar(300)
  tiktok             String?  @db.VarChar(300)
  fechaActualizacion DateTime @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?     @map("id_usuario_actualizo")

  usuarioActualizo Usuario? @relation("ContactoInstitucionalUsuarioActualizo", fields: [idUsuarioActualizo], references: [idUsuario], onDelete: SetNull, map: "fk_contacto_usuario")

  @@map("contacto_institucional")
}

/// Imagen de la tarjeta de una categoría en el inicio, con su punto de enfoque (0 a 100, 50 = centro) (FP-01)
model ImagenCategoriaInicio {
  idCategoria        Int      @id @map("id_categoria")
  contenido          Bytes
  mimeType           String   @map("mime_type") @db.VarChar(20)
  focoX              Int      @default(50) @map("foco_x") @db.SmallInt
  focoY              Int      @default(50) @map("foco_y") @db.SmallInt
  fechaActualizacion DateTime @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?     @map("id_usuario_actualizo")

  categoria        Categoria @relation(fields: [idCategoria], references: [idCategoria], onDelete: Cascade, map: "fk_imagen_categoria_inicio_categoria")
  usuarioActualizo Usuario?  @relation("ImagenCategoriaInicioUsuarioActualizo", fields: [idUsuarioActualizo], references: [idUsuario], onDelete: SetNull, map: "fk_imagen_categoria_inicio_usuario")

  @@map("imagen_categoria_inicio")
}

/// Entrada del catálogo de preguntas frecuentes (FAQ) para el Centro de Ayuda y puerto hacia M15
model FaqEntrada {
  idFaq              Int           @id @default(autoincrement()) @map("id_faq")
  pregunta           String        @db.VarChar(240)
  respuestaMarkdown  String        @map("respuesta_markdown")
  orden              Int           @default(0)
  estado             EstadoGeneral @default(activo)
  idAutor            Int?          @map("id_autor")
  fechaCreacion      DateTime      @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime      @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)

  autor Usuario? @relation("FaqEntradaAutor", fields: [idAutor], references: [idUsuario], onDelete: SetNull, map: "fk_faq_entrada_autor")

  @@index([estado, orden, idFaq], map: "idx_faq_entrada_estado_orden")
  @@index([idAutor], map: "idx_faq_entrada_autor")
  @@map("faq_entrada")
}

// =============================================================================
// MÓDULO M14 — PATROCINIOS Y PUBLICIDAD (esquema 4.17)
// =============================================================================

/// Campaña que pone productos por delante en el sitio (M14 · A1-A13). Fechas de calendario en hora de Colombia.
/// `uq_campania_nombre` (único sin distinguir mayúsculas ni espacios de los bordes) vive solo en el DDL: Prisma no expresa índices sobre funciones.
model CampaniaPatrocinio {
  idCampania         Int                   @id @default(autoincrement()) @map("id_campania")
  nombre             String                @db.VarChar(100)
  descripcion        String?               @db.VarChar(500)
  estado             EstadoGeneral         @default(activo)
  fechaInicio        DateTime              @map("fecha_inicio") @db.Date
  fechaFin           DateTime              @map("fecha_fin") @db.Date
  /// 0 a 100; el mayor va primero (M14 · A4)
  prioridad          Int                   @default(0) @db.SmallInt
  ubicaciones        UbicacionPatrocinio[]
  fechaCreacion      DateTime              @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime              @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?                  @map("id_usuario_actualizo")

  usuarioActualizo Usuario?           @relation("CampaniaPatrocinioUsuarioActualizo", fields: [idUsuarioActualizo], references: [idUsuario], onDelete: SetNull, map: "fk_campania_usuario")
  objetivos        CampaniaObjetivo[]

  @@index([estado, fechaInicio, fechaFin], map: "idx_campania_estado_fechas")
  @@map("campania_patrocinio")
}

/// Un producto, una línea o una marca que patrocina una campaña (M14 · A3). `idReferencia` no es FK: apunta a tres tablas según `tipo`.
model CampaniaObjetivo {
  idCampaniaObjetivo Int                    @id @default(autoincrement()) @map("id_campania_objetivo")
  idCampania         Int                    @map("id_campania")
  tipo               TipoObjetivoPatrocinio
  idReferencia       Int                    @map("id_referencia")

  campania CampaniaPatrocinio @relation(fields: [idCampania], references: [idCampania], onDelete: Cascade, map: "fk_campania_objetivo_campania")

  @@unique([idCampania, tipo, idReferencia], map: "uq_campania_objetivo")
  @@index([tipo, idReferencia], map: "idx_campania_objetivo_referencia")
  @@map("campania_objetivo")
}

/// Anuncio de un espacio publicitario: imagen y enlace al anunciante (M14 · B1-B9). Las imágenes viven en `AnuncioImagen`.
model AnuncioPublicitario {
  idAnuncio          Int                 @id @default(autoincrement()) @map("id_anuncio")
  nombre             String              @db.VarChar(100)
  anunciante         String              @db.VarChar(100)
  espacio            EspacioPublicitario
  textoAlternativo   String              @map("texto_alternativo") @db.VarChar(150)
  /// https://… o ruta interna (/…); nunca javascript:, data: ni http:// (M14 · B6)
  enlace             String?             @db.VarChar(500)
  estado             EstadoGeneral       @default(activo)
  fechaInicio        DateTime            @map("fecha_inicio") @db.Date
  fechaFin           DateTime            @map("fecha_fin") @db.Date
  /// Posición en el slider: el menor va primero (M14 · B4)
  orden              Int                 @default(0) @db.SmallInt
  /// Punto de enfoque de las imágenes, 0 a 100 (50 = centro): qué parte se ve cuando el espacio recorta (M14 · B8)
  focoEscritorioX    Int                 @default(50) @map("foco_escritorio_x") @db.SmallInt
  focoEscritorioY    Int                 @default(50) @map("foco_escritorio_y") @db.SmallInt
  focoMovilX         Int                 @default(50) @map("foco_movil_x") @db.SmallInt
  focoMovilY         Int                 @default(50) @map("foco_movil_y") @db.SmallInt
  fechaCreacion      DateTime            @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime            @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo Int?                @map("id_usuario_actualizo")

  usuarioActualizo Usuario?        @relation("AnuncioPublicitarioUsuarioActualizo", fields: [idUsuarioActualizo], references: [idUsuario], onDelete: SetNull, map: "fk_anuncio_usuario")
  imagenes         AnuncioImagen[]

  @@index([espacio, estado, fechaInicio, fechaFin], map: "idx_anuncio_espacio_vigencia")
  @@map("anuncio_publicitario")
}

/// Imagen de escritorio o móvil de un anuncio, original y reducidas (M14 · B7, B11). La sirve Pintu Clic, nunca un tercero.
model AnuncioImagen {
  idAnuncio Int                   @map("id_anuncio")
  variante  VarianteImagenAnuncio
  tamano    TamanoImagenAnuncio
  contenido Bytes
  mimeType  String                @map("mime_type") @db.VarChar(20)
  ancho     Int
  alto      Int

  anuncio AnuncioPublicitario @relation(fields: [idAnuncio], references: [idAnuncio], onDelete: Cascade, map: "fk_anuncio_imagen_anuncio")

  @@id([idAnuncio, variante, tamano])
  @@map("anuncio_imagen")
}

/// Impresiones y clics por día de una campaña o un anuncio (M14 · M1). Solo totales, sin datos personales.
/// `lugar` es la ubicación de la campaña o el espacio del anuncio. Sin FK: apunta a dos tablas según `entidad`.
model MedicionPatrocinio {
  fecha     DateTime        @db.Date
  entidad   EntidadMedicion
  idEntidad Int             @map("id_entidad")
  lugar     String          @db.VarChar(20)
  evento    EventoMedicion
  total     BigInt          @default(0)

  @@id([fecha, entidad, idEntidad, lugar, evento])
  @@index([entidad, idEntidad, fecha], map: "idx_medicion_entidad_fecha")
  @@map("medicion_patrocinio")
}

// =============================================================================
// MÓDULO M03 — ASESORÍA Y ASISTENCIA (HU-ASE-01, HU-ASE-02, HU-ASE-05, HU-ASE-06)
// =============================================================================

/// Modo de cuestionario vigente (M03 · D3): se cambia desde el panel, sin despliegue.
enum ModoCuestionario {
  fijo
  asistido

  @@map("enum_modo_cuestionario")
}

/// De dónde salen las opciones de una pregunta del modo fijo (M03 · F3).
enum OrigenOpcionesAsesoria {
  manual
  familias_color

  @@map("enum_origen_opciones_asesoria")
}

/// Qué hace elegir una opción (M03 · F2).
enum TipoEfectoAsesoria {
  filtrar
  filtrar_ambiente
  incluir

  @@map("enum_tipo_efecto_asesoria")
}

/// Dimensiones que M02 sabe filtrar y que viajan en la URL del catálogo (M03 · V1, V2).
enum DimensionFiltroAsesoria {
  categoria
  subcategoria
  superficie
  familia_color
  tipo_resina
  linea

  @@map("enum_dimension_filtro_asesoria")
}

/// Ambiente del producto, derivado de producto.uso_interior / uso_exterior de M01.
enum AmbienteAsesoria {
  interior
  exterior

  @@map("enum_ambiente_asesoria")
}

enum ServicioIa {
  gemini

  @@map("enum_servicio_ia")
}

enum FuncionIa {
  chat
  cuestionario

  @@map("enum_funcion_ia")
}

enum TipoIncidenteIa {
  tiempo_agotado
  no_disponible
  cuota_agotada
  respuesta_no_procesable
  error_configuracion

  @@map("enum_tipo_incidente_ia")
}

enum ResultadoIncidenteIa {
  recuperado
  fallido
  suspendido

  @@map("enum_resultado_incidente_ia")
}

/// Pregunta del cuestionario guiado administrable (M03 · HU-ASE-01, modo fijo).
/// No se borra: se desactiva (F5), para no romper un flujo a medias.
model PreguntaAsesoria {
  idPregunta Int    @id @default(autoincrement()) @map("id_pregunta")
  texto      String @db.VarChar(200)
  orden      Int    @default(0)
  /// `familias_color` = las opciones son las familias cromáticas activas del catálogo (F3)
  origenOpciones     OrigenOpcionesAsesoria @default(manual) @map("origen_opciones")
  estado             EstadoGeneral          @default(activo)
  fechaCreacion      DateTime               @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime               @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)

  opciones OpcionAsesoria[]

  @@index([estado, orden], map: "idx_pregunta_asesoria_orden")
  @@map("pregunta_asesoria")
}

/// Opción cerrada de una pregunta del cuestionario fijo (M03 · HU-ASE-01).
model OpcionAsesoria {
  idOpcion   Int           @id @default(autoincrement()) @map("id_opcion")
  idPregunta Int           @map("id_pregunta")
  texto      String        @db.VarChar(100)
  orden      Int           @default(0)
  estado     EstadoGeneral @default(activo)

  pregunta PreguntaAsesoria       @relation(fields: [idPregunta], references: [idPregunta], onDelete: Cascade, map: "fk_opcion_asesoria_pregunta")
  efectos  EfectoOpcionAsesoria[]

  @@index([idPregunta, orden], map: "idx_opcion_asesoria_pregunta")
  @@map("opcion_asesoria")
}

/// Correspondencia entre una opción y el filtro que aplica (M03 · RF-ASE-01-02, F2).
/// `idObjetivo` no es FK: apunta a seis tablas según `dimension`. El servicio comprueba que
/// exista y esté activo, y si no ignora el efecto sin error (M03 · F4).
model EfectoOpcionAsesoria {
  idEfecto   Int                      @id @default(autoincrement()) @map("id_efecto")
  idOpcion   Int                      @map("id_opcion")
  tipo       TipoEfectoAsesoria
  dimension  DimensionFiltroAsesoria?
  idObjetivo Int?                     @map("id_objetivo")
  ambiente   AmbienteAsesoria?
  /// Otras opciones que deben estar elegidas para que el efecto aplique, p. ej. Metal con Deteriorada (F2)
  requiereOpciones Int[] @default([]) @map("requiere_opciones")

  opcion OpcionAsesoria @relation(fields: [idOpcion], references: [idOpcion], onDelete: Cascade, map: "fk_efecto_asesoria_opcion")

  @@index([idOpcion], map: "idx_efecto_asesoria_opcion")
  @@map("efecto_opcion_asesoria")
}

/// Modo de cuestionario, guiones de la IA y parámetros de resiliencia; fila única (M03 · D3, D8).
model ConfiguracionAsesoria {
  idConfiguracion  Int              @id @default(1) @map("id_configuracion") @db.SmallInt
  modoCuestionario ModoCuestionario @default(fijo) @map("modo_cuestionario")
  /// K9: sugerencia de manos; null = no se sugiere ninguna (RF-ASE-02-06 prohíbe suponerlas)
  manosPorDefecto            Int?     @map("manos_por_defecto") @db.SmallInt
  guionCuestionario          String   @default("") @map("guion_cuestionario")
  guionAsistente             String   @default("") @map("guion_asistente")
  iaTiempoEsperaMs           Int      @default(8000) @map("ia_tiempo_espera_ms")
  iaReintentos               Int      @default(2) @map("ia_reintentos") @db.SmallInt
  iaSuspensionCuotaMinutos   Int      @default(60) @map("ia_suspension_cuota_minutos")
  iaRetencionIncidentesDias  Int      @default(90) @map("ia_retencion_incidentes_dias")
  iaFallosConsecutivosAlerta Int      @default(5) @map("ia_fallos_consecutivos_alerta") @db.SmallInt
  fechaActualizacion         DateTime @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  idUsuarioActualizo         Int?     @map("id_usuario_actualizo")

  usuarioActualizo Usuario? @relation("ConfiguracionAsesoriaUsuarioActualizo", fields: [idUsuarioActualizo], references: [idUsuario], onDelete: SetNull, map: "fk_config_asesoria_usuario")

  @@map("configuracion_asesoria")
}

/// Incidentes del servicio de IA, sin datos de la persona ni del contenido (M03 · I7).
/// Se purgan por retención (I8) y por eso NO viven en `registro_auditoria`, que es inmutable (D10).
model IncidenteIa {
  idIncidente Int                  @id @default(autoincrement()) @map("id_incidente")
  fecha       DateTime             @default(now()) @db.Timestamptz(6)
  servicio    ServicioIa           @default(gemini)
  funcion     FuncionIa
  tipo        TipoIncidenteIa
  intentos    Int                  @db.SmallInt
  resultado   ResultadoIncidenteIa

  @@index([fecha(sort: Desc)], map: "idx_incidente_ia_fecha")
  @@index([tipo, fecha(sort: Desc)], map: "idx_incidente_ia_tipo_fecha")
  @@map("incidente_ia")
}

// =============================================================================
// MÓDULO M20 — REGISTRO DE AUDITORÍA (HU-SEG-04, parte de escritura)
// =============================================================================

enum ResultadoAuditoria {
  exito
  fallo

  @@map("enum_resultado_auditoria")
}

/// Bitácora INMUTABLE de acciones relevantes (M20 · RF-SEG-04-02, RF-SEG-04-03).
/// El DDL revoca UPDATE y DELETE y además lo impide con un disparador (RF-SEG-04-04):
/// Prisma solo inserta y lee.
model RegistroAuditoria {
  idRegistro BigInt   @id @default(autoincrement()) @map("id_registro")
  fecha      DateTime @default(now()) @db.Timestamptz(6)
  idUsuario  Int?     @map("id_usuario")
  /// Copia del nombre del actor: el registro sigue siendo legible si la cuenta se elimina
  actor         String?            @db.VarChar(150)
  accion        String             @db.VarChar(100)
  entidad       String             @db.VarChar(60)
  idEntidad     String?            @map("id_entidad") @db.VarChar(60)
  valorAnterior String?            @map("valor_anterior")
  valorNuevo    String?            @map("valor_nuevo")
  resultado     ResultadoAuditoria @default(exito)
  ipOrigen      String?            @map("ip_origen") @db.VarChar(45)

  usuario Usuario? @relation(fields: [idUsuario], references: [idUsuario], onDelete: SetNull, map: "fk_auditoria_usuario")

  @@index([fecha(sort: Desc)], map: "idx_auditoria_fecha")
  @@index([entidad, idEntidad], map: "idx_auditoria_entidad")
  @@index([idUsuario], map: "idx_auditoria_usuario")
  @@map("registro_auditoria")
}

// =============================================================================
// MÓDULO M07 — CHECKOUT Y PAGO (contracts/m07-checkout.contract.ts · P1)
// =============================================================================

/// Estado de la solicitud de compra SOL-AAAA-NNNNN
enum EstadoSolicitudCompra {
  en_pago
  rechazada
  pagada
  completada
  en_revision
  vencida
  cancelada

  @@map("enum_estado_solicitud_compra")
}

/// Estado de un intento de pago en la pasarela
enum EstadoIntentoPago {
  pendiente
  aprobado
  rechazado
  error
  anulado

  @@map("enum_estado_intento_pago")
}

/// La compra congelada al pagar; también la cola de creación de la orden (R6)
model SolicitudCompra {
  idSolicitud         Int                   @id @default(autoincrement()) @map("id_solicitud")
  codigo              String                @unique @db.VarChar(20)
  idUsuario           Int                   @map("id_usuario")
  estado              EstadoSolicitudCompra @default(en_pago)
  origen              OrigenOrden           @default(carrito)
  idCotizacion        Int?                  @map("id_cotizacion")
  modoEntrega         ModoEntrega           @map("modo_entrega")
  direccion           String?
  costoEntrega        Decimal               @default(0) @map("costo_entrega") @db.Decimal(12, 2)
  subTotal            Decimal               @map("sub_total") @db.Decimal(12, 2)
  descuento           Decimal               @default(0) @db.Decimal(12, 2)
  descuentoEventos    Decimal               @default(0) @map("descuento_eventos") @db.Decimal(12, 2)
  descuentoEmpresa    Decimal               @default(0) @map("descuento_empresa") @db.Decimal(12, 2)
  totalMercancia      Decimal               @map("total_mercancia") @db.Decimal(12, 2)
  total               Decimal               @db.Decimal(12, 2)
  baseSinImpuesto     Decimal               @map("base_sin_impuesto") @db.Decimal(12, 2)
  importeIva          Decimal               @map("importe_iva") @db.Decimal(12, 2)
  tasaIva             Decimal               @map("tasa_iva") @db.Decimal(5, 2)
  /// Referencia a cupon, sin FK
  idCupon             Int?                  @map("id_cupon")
  importeCupon        Decimal               @default(0) @map("importe_cupon") @db.Decimal(12, 2)
  cuponRegistrado     Boolean               @default(false) @map("cupon_registrado")
  observaciones       String?
  transaccionPagoId   String?               @unique @map("transaccion_pago_id") @db.VarChar(100)
  montoPagado         Decimal?              @map("monto_pagado") @db.Decimal(12, 2)
  codigoOrden         String?               @map("codigo_orden") @db.VarChar(50)
  /// R17: comprada desde la ficha, sin el carrito
  compraDirecta       Boolean               @default(false) @map("compra_directa")
  reintentosOrden     Int                   @default(0) @map("reintentos_orden") @db.SmallInt
  proximoIntentoOrden DateTime?             @map("proximo_intento_orden") @db.Timestamptz(6)
  ultimoError         String?               @map("ultimo_error")
  venceEn             DateTime              @map("vence_en") @db.Timestamptz(6)
  fechaCreacion       DateTime              @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion  DateTime              @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)

  usuario    Usuario          @relation(fields: [idUsuario], references: [idUsuario], onUpdate: Cascade, onDelete: Restrict, map: "fk_solicitud_compra_usuario")
  cotizacion Cotizacion?      @relation(fields: [idCotizacion], references: [idCotizacion], onUpdate: Cascade, onDelete: SetNull, map: "fk_solicitud_compra_cotizacion")
  lineas     LineaSolicitud[]
  intentos   IntentoPago[]

  @@index([idUsuario, fechaCreacion(sort: Desc)], map: "idx_solicitud_compra_usuario")
  @@index([estado, fechaCreacion(sort: Desc)], map: "idx_solicitud_compra_estado")
  @@map("solicitud_compra")
}

/// Línea congelada de una solicitud de compra (sin FK al catálogo, como linea_orden)
model LineaSolicitud {
  idLineaSolicitud Int     @id @default(autoincrement()) @map("id_linea_solicitud")
  idSolicitud      Int     @map("id_solicitud")
  posicion         Int     @db.SmallInt
  idVariante       Int     @map("id_variante")
  idColor          Int?    @map("id_color")
  idCotizacion     Int?    @map("id_cotizacion")
  nombreProducto   String  @map("nombre_producto") @db.VarChar(150)
  marca            String? @db.VarChar(150)
  medida           String? @db.VarChar(150)
  sku              String? @db.VarChar(100)
  colorNombre      String? @map("color_nombre") @db.VarChar(150)
  colorHexadecimal String? @map("color_hexadecimal") @db.VarChar(7)
  cantidad         Int
  precioInicial    Decimal @map("precio_inicial") @db.Decimal(12, 2)
  precioAplicado   Decimal @map("precio_aplicado") @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)
  /// [{ordenAplicacion, origen, porcentaje, importe}]
  descuentos       Json    @default("[]")

  solicitud SolicitudCompra @relation(fields: [idSolicitud], references: [idSolicitud], onUpdate: Cascade, onDelete: Restrict, map: "fk_linea_solicitud_solicitud")

  @@unique([idSolicitud, posicion], map: "uq_linea_solicitud_posicion")
  @@index([idSolicitud], map: "idx_linea_solicitud_solicitud")
  @@map("linea_solicitud")
}

/// Un cobro enviado a la pasarela para una solicitud
model IntentoPago {
  idIntentoPago      Int               @id @default(autoincrement()) @map("id_intento_pago")
  idSolicitud        Int               @map("id_solicitud")
  numero             Int               @db.SmallInt
  referencia         String            @unique @db.VarChar(100)
  idTransaccion      String?           @unique @map("id_transaccion") @db.VarChar(100)
  estado             EstadoIntentoPago @default(pendiente)
  montoCentavos      BigInt            @map("monto_centavos")
  celularEnmascarado String            @map("celular_enmascarado") @db.VarChar(20)
  mensaje            String?           @db.VarChar(255)
  ultimaConsulta     DateTime?         @map("ultima_consulta") @db.Timestamptz(6)
  fechaCreacion      DateTime          @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime          @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)

  solicitud SolicitudCompra @relation(fields: [idSolicitud], references: [idSolicitud], onUpdate: Cascade, onDelete: Restrict, map: "fk_intento_pago_solicitud")

  @@unique([idSolicitud, numero], map: "uq_intento_pago_numero")
  @@index([idSolicitud], map: "idx_intento_pago_solicitud")
  @@map("intento_pago")
}
