{
  "name": "multiagent-sdlc-starter",
  "version": "1.2.0",
  "description": "Plantilla rectora universal para desarrollo de software guiado por multiagentes autónomos, artefactos inmutables y compuertas de calidad HITL.",
  "main": "tooling/init-project.mjs",
  "type": "module",
  "scripts": {
    "init:project": "node tooling/init-project.mjs",
    "check:no-any": "node tooling/check-no-any-frontend.mjs",
    "test:contracts": "node tooling/validate-contracts.mjs",
    "audit:dast": "node tooling/audit-security-runtime.mjs",
    "test:load": "node tooling/run-load-test.mjs",
    "audit:a11y": "node tooling/audit-a11y.mjs",
    "test": "npm run check:no-any && npm run test:contracts"
  },
  "keywords": [
    "multiagent",
    "sdlc",
    "ai-agents",
    "stage-gates",
    "hitl",
    "agentic-coding",
    "typescript",
    "template"
  ],
  "author": "DanExl24",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
