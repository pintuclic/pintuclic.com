# ─── API Backend ─────────────────────────────────────────────────────────────
# El navegador llama a /api/v1 en el mismo origen y Next lo reenvía aquí
# conservando el prefijo (next.config.ts). Solo servidor; se lee al compilar.
BACKEND_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

