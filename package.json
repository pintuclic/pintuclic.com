{
  "name": "pintuclic-gobernanza",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling de calidad de Pintu Clic: verificadores AST de Tolerancia Cero al tipo any, validacion de contratos Zod y auditoria de accesibilidad. No empaqueta aplicacion: el backend vive en backend/ y el frontend en frontend/.",
  "type": "module",
  "scripts": {
    "check:no-any": "node tooling/check-no-any-frontend.mjs backend/src frontend/src contracts",
    "test:contracts": "node tooling/validate-contracts.mjs",
    "audit:a11y": "node tooling/audit-a11y.mjs",
    "audit:core-kit": "node tooling/audit-core-kit.mjs",
    "audit:zod": "node tooling/audit-zod-chains.mjs",
    "audit:dast": "node tooling/audit-security-runtime.mjs",
    "test:load": "node tooling/run-load-test.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
