# Database
POSTGRES_USER=pintuclic
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=pintuclic
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public

# Backend
BACKEND_PORT=3000
BACKEND_IMAGE=ghcr.io/pintuclic/pintuclic.com/backend:latest
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Auth & Security
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_smtp_master_key
SMTP_FROM="Pintu Clic <notificaciones@pintuclic.com>"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODELO=
GEMINI_API_URL=

# Wompi (M07 Checkout)
WOMPI_API_URL=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# Frontend
FRONTEND_PORT=3001
FRONTEND_IMAGE=ghcr.io/pintuclic/pintuclic.com/frontend:latest
# Destino del proxy /api del frontend (se fija al compilar la imagen). El navegador
# llama a /api/v1 en el mismo origen; no se define NEXT_PUBLIC_API_URL.
BACKEND_URL=http://backend:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# M10 Entrega: token con el que el servicio de envíos (cuando se contrate) llama a POST /api/v1/entregas/webhook/:proveedor
ENVIOS_WEBHOOK_TOKEN=
