{
  "sdlc-stage-gate-enforcer": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('node:fs').then(fs => import(fs.existsSync('./scripts/check-sdlc-gate.mjs') ? './scripts/check-sdlc-gate.mjs' : './.agents/scripts/check-sdlc-gate.mjs'))\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
